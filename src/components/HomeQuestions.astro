---
import { marked } from 'marked';
import { groupNodes, tx, pageFor } from '../lib/site.mjs';
import ContentNodes from './ContentNodes.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import type { ContentBlock, Language } from '../lib/types';
interface Props { block: ContentBlock; lang: Language; }
const { block, lang } = Astro.props;
const { intro, groups } = groupNodes(block);
---
<section class="private-dialogue" id={block.anchor || block.id.toLowerCase()} data-block={block.id}>
  <div class="dialogue-heading wrap">
    <p class="eyebrow">{tx(lang, 'Con claridad', 'With clarity')}<span aria-hidden="true"></span>Solera Estates</p>
    <ContentNodes nodes={intro} />
  </div>
  <div class="dialogue-layout wrap">
    <div class="dialogue-portrait">
      <figure><ResponsiveImage name="terrace" lang={lang} sizes="(max-width: 760px) 90vw, 36vw" /></figure>
      <p class="dialogue-caption">{tx(lang, 'La confianza comienza con una conversación.', 'Trust begins with a conversation.')}</p>
      <a class="text-link" href={pageFor('CONTACTO', lang).route}>{tx(lang, 'Hablemos de tu propiedad', 'Let’s talk about your property')} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="dialogue-questions">
      {groups.map((group, index) => <details name={`solera-questions-${lang}`} open={index === 0}>
        <summary><h3 set:html={marked.parseInline(group.title)} /><span class="dialogue-toggle" aria-hidden="true"><span></span><span></span></span></summary>
        <div class="dialogue-answer"><ContentNodes nodes={group.nodes} /></div>
      </details>)}
      <p class="dialogue-signoff">{tx(lang, 'Atención personal. Criterio compartido. Una relación a largo plazo.', 'Personal attention. Shared understanding. A long-term relationship.')}</p>
    </div>
  </div>
</section>
