---
// Hero Section
---

<section id="inicio" class="relative min-h-screen flex items-center overflow-hidden bg-surface">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-grid"></div>
  <div class="hero-glow" style="top: 10%; left: -10%; background: var(--color-solera-500);"></div>
  <div class="hero-glow" style="bottom: 20%; right: -5%; background: var(--color-warm-500);"></div>
  
  <!-- Decorative floating elements -->
  <div class="absolute top-1/4 right-1/4 w-64 h-64 border border-solera-500/10 rounded-full animate-float" style="animation-delay: -2s;"></div>
  <div class="absolute bottom-1/3 left-1/3 w-48 h-48 border border-warm-500/10 rounded-full animate-float" style="animation-delay: -4s;"></div>
  <div class="absolute top-1/3 left-1/2 w-32 h-32 border border-solera-400/10 rounded-full animate-float" style="animation-delay: 0s;"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left content -->
      <div class="space-y-8 animate-fade-up">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-solera-500/10 border border-solera-500/20 text-solera-300 text-sm font-medium">
          <span class="w-2 h-2 rounded-full bg-solera-400 animate-pulse-soft"></span>
          Inmobiliaria Premium en Barcelona
        </div>
        
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-bold leading-[1.05] text-white">
          Encuentra el<br/>
          <span class="gradient-text">hogar de tus sueños</span><br/>
          en Barcelona
        </h1>
        
        <p class="text-lg md:text-xl text-slate-400 max-w-xl leading-relaxed">
          Más de 15 años ayudando a familias e inversores a encontrar la propiedad perfecta en las mejores zonas de Barcelona. Experiencia, confianza y propiedades exclusivas.
        </p>
        
        <div class="flex flex-wrap gap-4">
          <a href="/propiedades" class="btn-primary text-base px-8 py-4">
            Ver propiedades
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="/contacto" class="btn-secondary text-base px-8 py-4">
            Contactar
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          </a>
        </div>
        
        <!-- Trust badges -->
        <div class="flex flex-wrap items-center gap-8 pt-4">
          <div class="flex items-center gap-2 text-slate-500 text-sm">
            <svg class="w-5 h-5 text-warm-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/></svg>
            <span>Certificados energéticos</span>
          </div>
          <div class="flex items-center gap-2 text-slate-500 text-sm">
            <svg class="w-5 h-5 text-warm-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/></svg>
            <span>API (Agente Inmobiliario)</span>
          </div>
          <div class="flex items-center gap-2 text-slate-500 text-sm">
            <svg class="w-5 h-5 text-warm-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/></svg>
            <span>Financiación 100%</span>
          </div>
        </div>
      </div>
      
      <!-- Right: Floating cards -->
      <div class="hidden lg:block relative">
        <div class="relative w-full aspect-square">
          <!-- Main card -->
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-72 h-96 glass-card p-6 animate-float" style="animation-delay: -1s;">
              <div class="w-full h-32 rounded-xl bg-gradient-to-br from-solera-500/30 to-solera-700/30 mb-4 flex items-center justify-center">
                <svg class="w-12 h-12 text-solera-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
              </div>
              <div class="text-solera-400 text-sm font-medium mb-1">Ático de Lujo</div>
              <div class="text-white font-heading font-semibold text-lg mb-1">Pedralbes</div>
              <div class="text-slate-400 text-sm mb-3">250 m² · 4 hab · 3 baños</div>
              <div class="text-2xl font-heading font-bold gradient-text">3.500.000 €</div>
            </div>
          </div>
          
          <!-- Secondary card -->
          <div class="absolute bottom-0 right-0">
            <div class="w-56 glass-card p-5 animate-float" style="animation-delay: -3s;">
              <div class="w-full h-20 rounded-xl bg-gradient-to-br from-warm-500/20 to-warm-600/20 mb-3 flex items-center justify-center">
                <svg class="w-8 h-8 text-warm-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              </div>
              <div class="text-warm-400 text-xs font-medium mb-1">Piso Reformado</div>
              <div class="text-white text-sm font-heading font-semibold">Eixample Derecho</div>
              <div class="text-slate-400 text-xs">890.000 €</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
