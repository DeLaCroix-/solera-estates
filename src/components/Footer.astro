---
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy text-cream" role="contentinfo">
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand Column -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-6" aria-label="Solera Estates">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-gold to-gold-light flex items-center justify-center">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 12L12 3L21 12V20C21 20.55 20.55 21 20 21H15V15H9V21H4C3.45 21 3 20.55 3 20V12Z" fill="white"/>
            </svg>
          </div>
          <div>
            <span class="block text-lg font-display font-bold text-cream">Solera Estates</span>
            <span class="block text-xs text-gold tracking-widest uppercase">Barcelona</span>
          </div>
        </a>
        <p class="text-sm text-cream/70 leading-relaxed mb-6">
          Tu agencia inmobiliaria de confianza en Barcelona. Especialistas en propiedades de lujo, pisos, áticos y villas en los mejores barrios de la ciudad.
        </p>
        <!-- Social Media -->
        <div class="flex gap-3" aria-label="Redes sociales">
          <a href="https://instagram.com/soleraestates" target="_blank" rel="noopener noreferrer" aria-label="Instagram Solera Estates"
             class="w-9 h-9 rounded-full bg-cream/10 hover:bg-gold transition-colors flex items-center justify-center">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href="https://linkedin.com/company/soleraestates" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn Solera Estates"
             class="w-9 h-9 rounded-full bg-cream/10 hover:bg-gold transition-colors flex items-center justify-center">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://wa.me/34930000000" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Solera Estates"
             class="w-9 h-9 rounded-full bg-cream/10 hover:bg-gold transition-colors flex items-center justify-center">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold text-gold uppercase tracking-widest mb-5">Navegación</h3>
        <ul class="space-y-3" role="list">
          {[
            { href: '/', label: 'Inicio' },
            { href: '/propiedades', label: 'Propiedades' },
            { href: '/blog', label: 'Blog Inmobiliario' },
            { href: '/equipo', label: 'Nuestro Equipo' },
            { href: '/contacto', label: 'Contacto' },
          ].map(link => (
            <li>
              <a href={link.href} class="text-sm text-cream/70 hover:text-gold transition-colors flex items-center gap-2">
                <span class="w-1 h-1 rounded-full bg-gold/50 inline-block"></span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Neighborhoods -->
      <div>
        <h3 class="text-sm font-semibold text-gold uppercase tracking-widest mb-5">Barrios en Barcelona</h3>
        <ul class="space-y-3" role="list">
          {[
            'Eixample',
            'Gràcia',
            'Sarrià-Sant Gervasi',
            'El Born / Barceloneta',
            'Pedralbes',
            'Poblenou',
            'Les Corts',
            'Horta-Guinardó',
          ].map(barrio => (
            <li>
              <a href={`/propiedades?barrio=${barrio.toLowerCase().replace(/[^a-z0-9]/gi, '-')}`}
                 class="text-sm text-cream/70 hover:text-gold transition-colors flex items-center gap-2">
                <span class="w-1 h-1 rounded-full bg-gold/50 inline-block"></span>
                {barrio}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-sm font-semibold text-gold uppercase tracking-widest mb-5">Contacto</h3>
        <ul class="space-y-4" role="list">
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 text-gold mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="text-sm text-cream/70">Passeig de Gràcia, 42<br/>08007 Barcelona</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href="tel:+34930000000" class="text-sm text-cream/70 hover:text-gold transition-colors">+34 93 000 00 00</a>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href="mailto:info@soleraestates.com" class="text-sm text-cream/70 hover:text-gold transition-colors">info@soleraestates.com</a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 text-gold mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-sm text-cream/70">Lun–Vie: 9:00–19:00<br/>Sáb: 10:00–14:00</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-cream/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-5 flex flex-col md:flex-row items-center justify-between gap-3">
      <p class="text-xs text-cream/50">
        &copy; {currentYear} Solera Estates S.L. · Todos los derechos reservados · Agente API nº XXXXX
      </p>
      <div class="flex items-center gap-6">
        <a href="/aviso-legal" class="text-xs text-cream/50 hover:text-gold transition-colors">Aviso Legal</a>
        <a href="/privacidad" class="text-xs text-cream/50 hover:text-gold transition-colors">Privacidad</a>
        <a href="/cookies" class="text-xs text-cream/50 hover:text-gold transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>
