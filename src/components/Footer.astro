---
import { pageFor, tx } from '../lib/site.mjs';
import type { EditorialPage } from '../lib/types';
interface Props { page: EditorialPage; }
const { page } = Astro.props;
const l = page.lang;
---
<footer class="site-footer">
  <div class="footer-top">
    <div><p class="eyebrow">Private Real Estate Advisory</p><p class="footer-intro">{tx(l, 'Acompañamiento al propietario en Barcelona: cuidado de inmuebles, coordinación de reformas y asesoramiento en venta. Apoyo con vivienda y llegada para quienes se trasladan a la ciudad.', 'Property owner support in Barcelona: ongoing care, renovation coordination and advice for sellers. Housing and arrival support for people moving to the city.')}</p></div>
    <nav aria-label={tx(l, 'Servicios', 'Services')}><p class="eyebrow">{tx(l, 'Servicios', 'Services')}</p>{['GESTION', 'REFORMA', 'VENTA', 'LLEGADA'].map(id => {
      const item = pageFor(id, l);
      return <a class="footer-link" href={item.route}>{item.name}</a>;
    })}</nav>
    <div><p class="eyebrow">{tx(l, 'Contacto', 'Contact')}</p><a href="mailto:info@soleraestates.eu">info@soleraestates.eu</a><p>Barcelona</p><a class="text-link" href={pageFor('CONTACTO', l).route}>{tx(l, 'Plantear una consulta', 'Send an enquiry')}</a></div>
  </div>
  <nav class="footer-secondary" aria-label={tx(l, 'La firma y avisos legales', 'The firm and legal information')}>{['FIRMA', 'JOURNAL', 'LEGAL', 'PRIVACY', 'COOKIES'].map(id => {
    const item = pageFor(id, l);
    return <a class="footer-link" href={item.route}>{item.name}</a>;
  })}</nav>
  <div class="footer-wordmark" aria-hidden="true">SOLERA</div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} Solera Estates · NAT BPO SL</span><span>{tx(l, 'Imágenes conceptuales creadas con IA.', 'Conceptual imagery created with AI.')}</span><a href="#top">{tx(l, 'Volver arriba', 'Back to top')}</a></div>
</footer>
