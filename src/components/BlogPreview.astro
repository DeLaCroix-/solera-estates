---
import { blogPosts } from '../data/blog';
const recentPosts = blogPosts.slice(0, 3);
---

<section class="py-20 md:py-28 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-12 md:mb-16 animate-fade-up">
      <span class="inline-block text-solera-400 text-sm font-medium uppercase tracking-widest mb-3">Blog</span>
      <h2 class="section-title text-white">
        Últimas del <span class="gradient-text">Blog</span>
      </h2>
      <p class="section-subtitle mx-auto mt-4">
        Consejos, guías y novedades sobre el mercado inmobiliario en Barcelona
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 md:gap-8">
      {recentPosts.map((post, i) => (
        <a
          href={`/blog/${post.slug}`}
          class="group glass-card overflow-hidden transition-all duration-500 hover:-translate-y-2 animate-fade-up"
          style={`animation-delay: ${i * 0.15}s`}
        >
          <div class={`h-44 bg-gradient-to-br ${post.category === 'Guías' ? 'from-solera-500/20 to-solera-700/40' : post.category === 'Mercado' ? 'from-warm-500/20 to-solera-600/40' : 'from-solera-400/20 to-surface-3/40'} flex items-center justify-center`}>
            <svg class="w-12 h-12 text-white/10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
          </div>
          <div class="p-5">
            <div class="flex items-center gap-3 mb-3">
              <span class="property-tag">{post.category}</span>
              <span class="text-slate-500 text-xs">{post.date}</span>
            </div>
            <h3 class="text-white font-heading font-semibold text-lg mb-2 group-hover:text-solera-300 transition-colors line-clamp-2">
              {post.title}
            </h3>
            <p class="text-slate-400 text-sm leading-relaxed line-clamp-2 mb-4">
              {post.excerpt}
            </p>
            <div class="flex items-center justify-between text-sm">
              <span class="text-slate-500">{post.author}</span>
              <span class="text-solera-400 group-hover:text-solera-300 transition-colors font-medium flex items-center gap-1">
                Leer más
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="text-center mt-12">
      <a href="/blog" class="btn-secondary text-base px-8 py-4">
        Ver todas las publicaciones
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </div>
</section>
