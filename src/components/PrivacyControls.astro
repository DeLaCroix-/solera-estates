---
import { tx, pageFor } from '../lib/site.mjs';
import type { Language } from '../lib/types';
interface Props { lang: Language; }
const { lang } = Astro.props;
---
<aside id="cookie-notice" class="cookie-notice" aria-labelledby="cookie-title" hidden>
  <p class="eyebrow">Solera Estates · {tx(lang, 'Privacidad', 'Privacy')}</p>
  <h2 id="cookie-title">{tx(lang, 'Tu visita, a tu manera.', 'Your visit, your choice.')}</h2>
  <p>{tx(lang, 'Utilizamos tecnologías necesarias para atender tus consultas. Con tu permiso, medimos la navegación con Google Analytics y nuestro CRM para mejorar la web y comprender las consultas recibidas.', 'We use necessary technologies to handle your enquiries. With your permission, Google Analytics and our CRM measure browsing activity to help improve the website and understand enquiries.')}</p>
  <a class="cookie-policy" href={pageFor('COOKIES', lang).route}>{tx(lang, 'Leer la política de cookies', 'Read the cookie policy')}</a>
  <div id="cookie-preferences" hidden>
    <div class="cookie-option"><span><strong>{tx(lang, 'Necesarias', 'Necessary')}</strong><small>{tx(lang, 'Preferencias de privacidad y funcionamiento del formulario.', 'Privacy preferences and enquiry form functionality.')}</small></span><span class="cookie-always">{tx(lang, 'Siempre activas', 'Always active')}</span></div>
    <label class="cookie-option" for="analytics-consent"><span><strong>{tx(lang, 'Analítica', 'Analytics')}</strong><small>{tx(lang, 'Google Analytics y actividad web del CRM. Sin publicidad.', 'Google Analytics and CRM website activity. No advertising.')}</small></span><input id="analytics-consent" type="checkbox" /></label>
  </div>
  <div class="cookie-actions"><button type="button" data-cookie-accept>{tx(lang, 'Aceptar', 'Accept')}</button><button type="button" data-cookie-reject>{tx(lang, 'Rechazar', 'Reject')}</button></div>
  <button type="button" class="cookie-configure" data-cookie-configure aria-expanded="false" aria-controls="cookie-preferences">{tx(lang, 'Configurar preferencias', 'Set preferences')}</button>
  <button type="button" class="cookie-save" data-cookie-save hidden>{tx(lang, 'Guardar preferencias', 'Save preferences')}</button>
</aside>
<a class="go-up" href="#top" aria-label={tx(lang, 'Subir al inicio', 'Back to top')} title={tx(lang, 'Subir al inicio', 'Back to top')} hidden><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 20V4m-6 6 6-6 6 6" /></svg></a>
