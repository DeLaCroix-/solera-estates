---
import { pageFor, tx } from '../lib/site.mjs';
import type { EditorialPage } from '../lib/types';
interface Props { page: EditorialPage; }
const { page: p } = Astro.props;
const lang = p.lang;
const alternate = pageFor(p.id, lang === 'es' ? 'en' : 'es');
const contact = pageFor('CONTACTO', lang).route;
---
<a class="skip" href="#main">{tx(lang, 'Saltar al contenido', 'Skip to content')}</a>
<header class:list={['site-header', { 'over-hero': p.id === 'HOME' }]}>
  <a class="brand" href={pageFor('HOME', lang).route} aria-label={`Solera Estates · ${tx(lang, 'Inicio', 'Home')}`}><span>SOLERA</span><small>ESTATES</small></a>
  <nav class="desktop-nav" aria-label={tx(lang, 'Navegación principal', 'Main navigation')}>
    <a class="nav-link" href={pageFor('FIRMA', lang).route}>{tx(lang, 'La firma', 'The firm')}</a>
    <a class="nav-link" href={pageFor('HOME', lang).route + '#servicios'}>{tx(lang, 'Servicios', 'Services')}</a>
    <a class="nav-link" href={pageFor('JOURNAL', lang).route}>Journal</a>
  </nav>
  <div class="header-actions">
    <nav class="languages" aria-label={tx(lang, 'Cambiar idioma', 'Change language')}>
      <a href={lang === 'es' ? p.route : alternate.route} lang="es" hreflang="es" aria-current={lang === 'es' ? 'page' : undefined}>ES</a><span aria-hidden="true">/</span><a href={lang === 'en' ? p.route : alternate.route} lang="en" hreflang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
    </nav>
    <a class="header-contact" href={contact + '#formulario'}>{tx(lang, 'Plantear una consulta', 'Send an enquiry')}</a>
    <button class="menu-toggle" type="button" aria-controls="menu-panel" aria-expanded="false" aria-label={tx(lang, 'Abrir menú', 'Open menu')} data-open={tx(lang, 'Abrir menú', 'Open menu')} data-close={tx(lang, 'Cerrar menú', 'Close menu')}><span></span><span></span></button>
  </div>
</header>
<nav id="menu-panel" class="menu-panel" hidden aria-label={tx(lang, 'Todas las páginas', 'All pages')}>
  <div class="menu-inner">
    <p class="eyebrow">Solera Estates · Barcelona</p>
    <div class="menu-main">{['HOME', 'FIRMA', 'GESTION', 'REFORMA', 'VENTA', 'LLEGADA', 'JOURNAL', 'CONTACTO'].map(id => {
      const item = pageFor(id, lang);
      return <a class="menu-link" href={item.route}>{item.name}</a>;
    })}</div>
    <a class="text-link" href={pageFor('GESTION', lang).route + tx(lang, '#propietarios-internacionales', '#international-owners')}>{tx(lang, 'Propietarios internacionales', 'International owners')}</a>
    <a class="menu-email" href="mailto:info@soleraestates.eu">info@soleraestates.eu</a>
  </div>
</nav>
