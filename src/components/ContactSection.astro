---
// Contact Section
---

<section id="contacto" class="py-20 md:py-28 relative overflow-hidden">
  <div class="absolute inset-0 bg-grid opacity-30"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-12 md:mb-16 animate-fade-up">
      <span class="inline-block text-solera-400 text-sm font-medium uppercase tracking-widest mb-3">Contacto</span>
      <h2 class="section-title text-white">
        ¿Hablamos sobre tu <span class="gradient-text">próximo hogar</span>?
      </h2>
      <p class="section-subtitle mx-auto mt-4">
        Estaremos encantados de atenderte y resolver todas tus dudas
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-10">
      <!-- Form -->
      <div class="glass-card p-8 md:p-10 animate-fade-up">
        <h3 class="text-white font-heading font-semibold text-xl mb-6">Envíanos un mensaje</h3>
        <form id="contactForm" class="space-y-5">
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="nombre" class="block text-sm text-slate-300 mb-1.5 font-medium">Nombre</label>
              <input type="text" id="nombre" required placeholder="Tu nombre" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700/50 text-slate-200 text-sm focus:outline-none focus:border-solera-500 focus:ring-1 focus:ring-solera-500/30 transition-colors placeholder:text-slate-500"/>
            </div>
            <div>
              <label for="email" class="block text-sm text-slate-300 mb-1.5 font-medium">Email</label>
              <input type="email" id="email" required placeholder="tu@email.com" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700/50 text-slate-200 text-sm focus:outline-none focus:border-solera-500 focus:ring-1 focus:ring-solera-500/30 transition-colors placeholder:text-slate-500"/>
            </div>
          </div>
          <div>
            <label for="telefono" class="block text-sm text-slate-300 mb-1.5 font-medium">Teléfono</label>
            <input type="tel" id="telefono" placeholder="+34 612 345 678" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700/50 text-slate-200 text-sm focus:outline-none focus:border-solera-500 focus:ring-1 focus:ring-solera-500/30 transition-colors placeholder:text-slate-500"/>
          </div>
          <div>
            <label for="mensaje" class="block text-sm text-slate-300 mb-1.5 font-medium">Mensaje</label>
            <textarea id="mensaje" rows="4" required placeholder="Cuéntanos qué estás buscando..." class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700/50 text-slate-200 text-sm focus:outline-none focus:border-solera-500 focus:ring-1 focus:ring-solera-500/30 transition-colors placeholder:text-slate-500 resize-none"></textarea>
          </div>
          <button type="submit" class="btn-primary text-base px-8 py-4 w-full justify-center">
            Enviar mensaje
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          </button>
        </form>
      </div>

      <!-- Info -->
      <div class="space-y-6 animate-fade-up" style="animation-delay: 0.2s">
        <div class="glass-card p-8">
          <h3 class="text-white font-heading font-semibold text-xl mb-6">Información de contacto</h3>
          <div class="space-y-5">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-solera-500/10 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-solera-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <div class="text-white font-heading font-semibold mb-1">Oficina Central</div>
                <div class="text-slate-400 text-sm">Passeig de Gràcia, 123<br/>08008 Barcelona</div>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-solera-500/10 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-solera-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <div class="text-white font-heading font-semibold mb-1">Teléfono</div>
                <div class="text-slate-400 text-sm">+34 932 123 456</div>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-solera-500/10 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-solera-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <div class="text-white font-heading font-semibold mb-1">Email</div>
                <div class="text-slate-400 text-sm">info@soleraestates.com</div>
              </div>
            </div>
          </div>
        </div>

        <div class="glass-card p-8">
          <h3 class="text-white font-heading font-semibold text-xl mb-4">Horario de atención</h3>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between text-slate-300"><span>Lunes a viernes</span><span>09:00 – 19:00</span></div>
            <div class="flex justify-between text-slate-300"><span>Sábados</span><span>10:00 – 14:00</span></div>
            <div class="flex justify-between text-slate-500"><span>Domingos</span><span>Cerrado</span></div>
          </div>
        </div>

        <div class="glass-card p-8">
          <h3 class="text-white font-heading font-semibold text-xl mb-4">Ubicación</h3>
          <div class="h-48 rounded-xl bg-gradient-to-br from-slate-800 to-slate-900 flex items-center justify-center border border-slate-700/50">
            <div class="text-center">
              <svg class="w-10 h-10 text-solera-400 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span class="text-slate-500 text-xs">Passeig de Gràcia, 123 · 08008 Barcelona</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const contactForm = document.getElementById('contactForm');
  if (contactForm) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Gracias por contactar con Solera Estates. Te responderemos en menos de 24 horas.');
      contactForm.reset();
    });
  }
</script>
