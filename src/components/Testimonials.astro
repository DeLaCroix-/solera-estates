---
// Testimonials Carousel
---

<section class="py-20 md:py-28 relative overflow-hidden">
  <div class="absolute inset-0 bg-grid opacity-30"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-12 md:mb-16 animate-fade-up">
      <span class="inline-block text-solera-400 text-sm font-medium uppercase tracking-widest mb-3">Testimonios</span>
      <h2 class="section-title text-white">
        Lo que dicen nuestros <span class="gradient-text">clientes</span>
      </h2>
      <p class="section-subtitle mx-auto mt-4">
        La satisfacción de nuestros clientes es nuestra mejor carta de presentación
      </p>
    </div>

    <div class="relative max-w-4xl mx-auto" id="testimonialCarousel">
      <div class="overflow-hidden">
        <div class="flex transition-transform duration-500 ease-out" id="testimonialTrack">
          <!-- Testimonial 1 -->
          <div class="min-w-full px-4">
            <div class="glass-card p-8 md:p-10 text-center">
              <div class="flex justify-center mb-4">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-5 h-5 text-warm-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
              <blockquote class="text-slate-300 text-lg md:text-xl leading-relaxed mb-6">
                "Solera Estates hizo que comprar nuestro piso en Barcelona fuera una experiencia increíble. Su equipo conocía cada detalle del mercado y nos guiaron en todo el proceso. Encontramos el hogar perfecto para nuestra familia."
              </blockquote>
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-solera-500 to-solera-700 flex items-center justify-center text-white font-heading font-bold text-lg mx-auto mb-3">MC</div>
              <div class="font-heading font-semibold text-white">María y Carlos</div>
              <div class="text-slate-400 text-sm">Compradores · Eixample</div>
            </div>
          </div>
          
          <!-- Testimonial 2 -->
          <div class="min-w-full px-4">
            <div class="glass-card p-8 md:p-10 text-center">
              <div class="flex justify-center mb-4">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-5 h-5 text-warm-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
              <blockquote class="text-slate-300 text-lg md:text-xl leading-relaxed mb-6">
                "Como inversor internacional, necesitaba una agencia que entendiera el mercado de lujo en Barcelona. Solera Estates superó todas mis expectativas. Profesionalidad, discreción y un portfolio de propiedades excepcional."
              </blockquote>
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-warm-500 to-warm-600 flex items-center justify-center text-white font-heading font-bold text-lg mx-auto mb-3">AJ</div>
              <div class="font-heading font-semibold text-white">Alexander J.</div>
              <div class="text-slate-400 text-sm">Inversor · Pedralbes</div>
            </div>
          </div>
          
          <!-- Testimonial 3 -->
          <div class="min-w-full px-4">
            <div class="glass-card p-8 md:p-10 text-center">
              <div class="flex justify-center mb-4">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-5 h-5 text-warm-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
              <blockquote class="text-slate-300 text-lg md:text-xl leading-relaxed mb-6">
                "Vendimos nuestra casa en Sarrià en tiempo récord gracias a Solera Estates. Su estrategia de marketing y el conocimiento del mercado hicieron que recibiéramos ofertas desde la primera semana. Recomendados 100%."
              </blockquote>
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-solera-400 to-solera-600 flex items-center justify-center text-white font-heading font-bold text-lg mx-auto mb-3">LP</div>
              <div class="font-heading font-semibold text-white">Laura P.</div>
              <div class="text-slate-400 text-sm">Vendedora · Sarrià</div>
            </div>
          </div>
          
          <!-- Testimonial 4 -->
          <div class="min-w-full px-4">
            <div class="glass-card p-8 md:p-10 text-center">
              <div class="flex justify-center mb-4">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-5 h-5 text-warm-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
              <blockquote class="text-slate-300 text-lg md:text-xl leading-relaxed mb-6">
                "Buscábamos un local comercial en El Born y Solera Estates nos encontró el espacio ideal. Su asesoramiento sobre la viabilidad del negocio y la licencia de actividad fue clave. Llevamos 6 meses y no podríamos estar más contentos."
              </blockquote>
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-solera-500 to-warm-600 flex items-center justify-center text-white font-heading font-bold text-lg mx-auto mb-3">TR</div>
              <div class="font-heading font-semibold text-white">Teresa R.</div>
              <div class="text-slate-400 text-sm">Emprendedora · El Born</div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Dots -->
      <div class="flex justify-center gap-3 mt-8">
        {[0, 1, 2, 3].map((_, i) => (
          <button
            class="testimonial-dot w-2.5 h-2.5 rounded-full transition-all duration-300"
            data-index={i}
            aria-label={`Testimonio ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    const track = document.getElementById('testimonialTrack');
    const dots = document.querySelectorAll('.testimonial-dot');
    let currentIndex = 0;
    const totalSlides = dots.length;
    let interval;

    function goTo(index) {
      currentIndex = index;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.add('bg-solera-400', 'w-8');
          dot.classList.remove('bg-slate-600', 'w-2.5');
        } else {
          dot.classList.remove('bg-solera-400', 'w-8');
          dot.classList.add('bg-slate-600', 'w-2.5');
        }
      });
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        goTo(i);
        clearInterval(interval);
        interval = setInterval(() => goTo((currentIndex + 1) % totalSlides), 6000);
      });
    });

    // Auto-advance
    goTo(0);
    interval = setInterval(() => goTo((currentIndex + 1) % totalSlides), 6000);
  })();
</script>
