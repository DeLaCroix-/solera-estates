---
// Stats Section
---

<section class="py-20 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-solera-950/30 to-surface"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      <div class="glass-card p-8 text-center animate-fade-up hover:-translate-y-1 transition-transform duration-300">
        <div class="text-4xl md:text-5xl font-heading font-bold gradient-text mb-2">15+</div>
        <div class="text-slate-400 text-sm font-medium">Años de experiencia</div>
        <div class="mt-3 w-12 h-0.5 bg-solera-500/30 mx-auto rounded-full"></div>
      </div>
      <div class="glass-card p-8 text-center animate-fade-up hover:-translate-y-1 transition-transform duration-300" style="animation-delay: 0.1s">
        <div class="text-4xl md:text-5xl font-heading font-bold gradient-text mb-2">500+</div>
        <div class="text-slate-400 text-sm font-medium">Propiedades vendidas</div>
        <div class="mt-3 w-12 h-0.5 bg-solera-500/30 mx-auto rounded-full"></div>
      </div>
      <div class="glass-card p-8 text-center animate-fade-up hover:-translate-y-1 transition-transform duration-300" style="animation-delay: 0.2s">
        <div class="text-4xl md:text-5xl font-heading font-bold gradient-text mb-2">98%</div>
        <div class="text-slate-400 text-sm font-medium">Satisfacción cliente</div>
        <div class="mt-3 w-12 h-0.5 bg-solera-500/30 mx-auto rounded-full"></div>
      </div>
      <div class="glass-card p-8 text-center animate-fade-up hover:-translate-y-1 transition-transform duration-300" style="animation-delay: 0.3s">
        <div class="text-4xl md:text-5xl font-heading font-bold gradient-text mb-2">50+</div>
        <div class="text-slate-400 text-sm font-medium">Premios y reconocimientos</div>
        <div class="mt-3 w-12 h-0.5 bg-solera-500/30 mx-auto rounded-full"></div>
      </div>
    </div>
  </div>
</section>
