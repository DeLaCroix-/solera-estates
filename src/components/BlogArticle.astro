---
import type { BlogArticle } from '../lib/types';
import { articles, pageFor, tx } from '../lib/site.mjs';
import BlogImage from './BlogImage.astro';
import '../blog.css';
interface Props { article: BlogArticle; }
const { article: a } = Astro.props;
const l = a.lang;
const date = (value: string) => new Intl.DateTimeFormat(l === 'es' ? 'es-ES' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' }).format(new Date(value));
const related = (articles as BlogArticle[]).filter(post => post.lang === l && post.route !== a.route).sort((x, y) => Number(y.category === a.category) - Number(x.category === a.category)).slice(0, 2);
---
<article class="blog-article">
  <header class="article-heading wrap"><nav class="article-breadcrumb" aria-label={tx(l, 'Ruta de navegación', 'Breadcrumb')}><a href={pageFor('HOME', l).route}>{tx(l, 'Inicio', 'Home')}</a><span aria-hidden="true">/</span><a href={pageFor('BLOG', l).route}>Blog</a></nav><p class="eyebrow">{a.category}</p><h1>{a.heading}</h1><p class="article-standfirst">{a.description}</p><div class="article-byline"><span>{a.author}</span><time datetime={a.publishDate}>{date(a.publishDate)}</time><span>{a.readingMinutes} {tx(l, 'min de lectura', 'min read')}</span>{a.updatedDate !== a.publishDate && <span>{tx(l, 'Actualizado:', 'Updated:')} <time datetime={a.updatedDate}>{date(a.updatedDate)}</time></span>}</div></header>
  <figure class="article-cover wrap"><BlogImage image={a.image} lang={l} eager sizes="90vw" /></figure>
  <div class="article-reading wrap"><aside class="article-rail"><p class="eyebrow">{tx(l, 'En esta lectura', 'In this article')}</p>{a.toc.length > 0 && <nav aria-label={tx(l, 'Índice del artículo', 'Article contents')}>{a.toc.map(item => <a href={'#' + item.id}>{item.text}</a>)}</nav>}<a class="article-back" href={pageFor('BLOG', l).route}><span aria-hidden="true">←</span> {tx(l, 'Volver al Blog', 'Back to the Blog')}</a></aside><div class="article-prose" set:html={a.html} /></div>
</article>
<section class="article-conversation wrap" aria-labelledby="article-conversation-title"><p class="eyebrow">{tx(l, 'Tu propiedad, en contexto', 'Your property, in context')}</p><h2 id="article-conversation-title">{tx(l, 'Cada situación merece una conversación propia.', 'Every situation deserves its own conversation.')}</h2><a class="button button-dark" href={pageFor('CONTACTO', l).route + '#formulario'}>{tx(l, 'Plantear una consulta', 'Send an enquiry')} <span aria-hidden="true">↗</span></a></section>
{related.length > 0 && <section class="blog-collection wrap" aria-labelledby="related-title"><div class="blog-section-heading"><p class="eyebrow">{tx(l, 'Continúa la lectura', 'Continue reading')}</p><h2 id="related-title">{tx(l, 'Otras perspectivas', 'Further perspectives')}</h2></div><div class="blog-grid blog-grid-related">{related.map(post => <article class="blog-card"><a class="blog-card-image" href={post.route} aria-label={post.heading}><BlogImage image={post.image} lang={l} /><span class="blog-image-arrow" aria-hidden="true">↗</span></a><p class="eyebrow">{post.category}</p><h3><a href={post.route}>{post.heading}</a></h3></article>)}</div></section>}
