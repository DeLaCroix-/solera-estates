---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  structuredData?: Record<string, any>;
}

const {
  title,
  description,
  canonical = 'https://soleraestates.com',
  ogType = 'website',
  ogTitle,
  ogDescription,
  ogImage = 'https://soleraestates.com/images/og-default.jpg',
  structuredData,
} = Astro.props;

const defaultStructuredData = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  "@id": "https://soleraestates.com",
  "name": "Solera Estates",
  "description": "Inmobiliaria de lujo en Barcelona. Compra y venta de propiedades exclusivas en las mejores zonas de Barcelona.",
  "url": "https://soleraestates.com",
  "telephone": "+34 932 123 456",
  "email": "info@soleraestates.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Passeig de Gràcia, 123",
    "addressLocality": "Barcelona",
    "addressRegion": "Barcelona",
    "postalCode": "08008",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 41.3924,
    "longitude": 2.1651
  },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Monday", "opens": "09:00", "closes": "19:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Tuesday", "opens": "09:00", "closes": "19:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Wednesday", "opens": "09:00", "closes": "19:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Thursday", "opens": "09:00", "closes": "19:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Friday", "opens": "09:00", "closes": "19:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "10:00", "closes": "14:00" }
  ],
  "sameAs": [
    "https://instagram.com/soleraestates",
    "https://facebook.com/soleraestates",
    "https://linkedin.com/company/soleraestates"
  ]
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle || title} />
    <meta property="og:description" content={ogDescription || description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Solera Estates" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle || title} />
    <meta name="twitter:description" content={ogDescription || description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData || defaultStructuredData)} />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-surface text-slate-100 antialiased">
    <!-- NAV -->
    <nav id="navbar" class="glass-nav fixed top-0 left-0 right-0 z-50 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 md:h-20">
          <a href="/" class="flex items-center gap-2 group">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-solera-500 to-solera-700 flex items-center justify-center text-white font-bold font-heading text-lg transition-transform duration-300 group-hover:scale-105">SE</div>
            <span class="text-xl font-heading font-semibold text-white hidden sm:block">Solera <span class="text-solera-400">Estates</span></span>
          </a>

          <!-- DESKTOP LINKS -->
          <div class="hidden md:flex items-center gap-8">
            <a href="/" class="text-slate-300 hover:text-white transition-colors text-sm font-medium">Inicio</a>
            <a href="/propiedades" class="text-slate-300 hover:text-white transition-colors text-sm font-medium">Propiedades</a>
            <a href="/blog" class="text-slate-300 hover:text-white transition-colors text-sm font-medium">Blog</a>
            <a href="/sobre-nosotros" class="text-slate-300 hover:text-white transition-colors text-sm font-medium">Sobre Nosotros</a>
            <a href="/contacto" class="btn-primary text-sm">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              Contacto
            </a>
          </div>

          <!-- MOBILE HAMBURGER -->
          <button id="menuBtn" class="md:hidden p-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-colors" aria-label="Abrir menú">
            <svg id="menuIcon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- MOBILE MENU -->
      <div id="mobileMenu" class="md:hidden hidden">
        <div class="px-4 py-4 space-y-2 border-t border-slate-700/50">
          <a href="/" class="block px-4 py-3 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition-colors text-sm font-medium">Inicio</a>
          <a href="/propiedades" class="block px-4 py-3 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition-colors text-sm font-medium">Propiedades</a>
          <a href="/blog" class="block px-4 py-3 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition-colors text-sm font-medium">Blog</a>
          <a href="/sobre-nosotros" class="block px-4 py-3 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition-colors text-sm font-medium">Sobre Nosotros</a>
          <a href="/contacto" class="block px-4 py-3 rounded-xl text-white bg-gradient-to-r from-solera-500 to-solera-600 font-medium text-sm mt-3">Contacto</a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-slate-900/50 border-t border-slate-800/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
          <!-- Brand -->
          <div class="space-y-4">
            <a href="/" class="flex items-center gap-2">
              <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-solera-500 to-solera-700 flex items-center justify-center text-white font-bold font-heading text-sm">SE</div>
              <span class="text-lg font-heading font-semibold text-white">Solera <span class="text-solera-400">Estates</span></span>
            </a>
            <p class="text-slate-400 text-sm leading-relaxed">Inmobiliaria premium en Barcelona. Más de 15 años ayudando a encontrar el hogar perfecto en las mejores zonas de la ciudad.</p>
            <div class="flex gap-3">
              <a href="#" class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center text-slate-400 hover:bg-solera-500 hover:text-white transition-all" aria-label="Instagram">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              </a>
              <a href="#" class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center text-slate-400 hover:bg-solera-500 hover:text-white transition-all" aria-label="Facebook">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href="#" class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center text-slate-400 hover:bg-solera-500 hover:text-white transition-all" aria-label="LinkedIn">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            </div>
          </div>

          <!-- Quick Links -->
          <div>
            <h4 class="text-white font-heading font-semibold mb-4">Enlaces Rápidos</h4>
            <ul class="space-y-3">
              <li><a href="/" class="text-slate-400 hover:text-solera-400 transition-colors text-sm">Inicio</a></li>
              <li><a href="/propiedades" class="text-slate-400 hover:text-solera-400 transition-colors text-sm">Propiedades</a></li>
              <li><a href="/blog" class="text-slate-400 hover:text-solera-400 transition-colors text-sm">Blog</a></li>
              <li><a href="/sobre-nosotros" class="text-slate-400 hover:text-solera-400 transition-colors text-sm">Sobre Nosotros</a></li>
              <li><a href="/contacto" class="text-slate-400 hover:text-solera-400 transition-colors text-sm">Contacto</a></li>
            </ul>
          </div>

          <!-- Properties by Type -->
          <div>
            <h4 class="text-white font-heading font-semibold mb-4">Propiedades</h4>
            <ul class="space-y-3">
              <li><a href="/propiedades?tipo=piso" class="text-slate-400 hover:text-solera-400 transition-colors text-sm">Pisos en Barcelona</a></li>
              <li><a href="/propiedades?tipo=ático" class="text-slate-400 hover:text-solera-400 transition-colors text-sm">Áticos en Barcelona</a></li>
              <li><a href="/propiedades?tipo=casa" class="text-slate-400 hover:text-solera-400 transition-colors text-sm">Casas en Barcelona</a></li>
              <li><a href="/propiedades?tipo=local" class="text-slate-400 hover:text-solera-400 transition-colors text-sm">Locales Comerciales</a></li>
              <li><a href="/propiedades?tipo=oficina" class="text-slate-400 hover:text-solera-400 transition-colors text-sm">Oficinas en Barcelona</a></li>
            </ul>
          </div>

          <!-- Contact -->
          <div>
            <h4 class="text-white font-heading font-semibold mb-4">Contacto</h4>
            <ul class="space-y-3 text-sm text-slate-400">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-solera-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span>Passeig de Gràcia, 123<br/>08008 Barcelona</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-solera-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                <span>+34 932 123 456</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-solera-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <span>info@soleraestates.com</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-12 pt-8 border-t border-slate-800/50 flex flex-col md:flex-row items-center justify-between gap-4">
          <p class="text-slate-500 text-xs">&copy; {new Date().getFullYear()} Solera Estates. Todos los derechos reservados.</p>
          <p class="text-slate-500 text-xs">Hecho con ❤️ en Barcelona</p>
        </div>
      </div>
    </footer>

    <!-- Scroll to top -->
    <button id="scrollTop" class="scroll-to-top" aria-label="Volver arriba">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
    </button>

    <script>
      // Mobile menu toggle
      const menuBtn = document.getElementById('menuBtn');
      const mobileMenu = document.getElementById('mobileMenu');
      const menuIcon = document.getElementById('menuIcon');
      
      if (menuBtn) {
        menuBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
          const isOpen = !mobileMenu.classList.contains('hidden');
          menuIcon.innerHTML = isOpen
            ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>'
            : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>';
        });
      }

      // Navbar shadow on scroll
      const navbar = document.getElementById('navbar');
      let lastScroll = 0;
      window.addEventListener('scroll', () => {
        const currentScroll = window.pageYOffset;
        if (currentScroll > 50) {
          navbar.classList.add('shadow-lg', 'shadow-black/10');
        } else {
          navbar.classList.remove('shadow-lg', 'shadow-black/10');
        }
        lastScroll = currentScroll;
      });

      // Scroll to top button
      const scrollTop = document.getElementById('scrollTop');
      window.addEventListener('scroll', () => {
        if (window.pageYOffset > 400) {
          scrollTop.classList.add('visible');
        } else {
          scrollTop.classList.remove('visible');
        }
      });
      scrollTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
