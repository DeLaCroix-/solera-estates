---
import { origin, excludedFromIndex, alternatesFor } from '../lib/site.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrivacyControls from '../components/PrivacyControls.astro';
import '../style.css';
import type { EditorialPage, BlogArticle } from '../lib/types';
interface Props { page: EditorialPage; }
const { page: p } = Astro.props;
const alternates = alternatesFor(p);
const article = p.isArticle ? p as BlogArticle : null;
const shareImage = origin + (article?.image?.src || '/assets/hero-1920.webp');
const graph: Record<string, any>[] = [
  { '@type': 'Organization', '@id': origin + '/#organization', name: 'Solera Estates', legalName: 'NAT BPO SL', taxID: 'B26663120', url: origin + '/', email: 'info@soleraestates.eu' },
  { '@type': 'WebSite', '@id': origin + '/#website', url: origin + '/', name: 'Solera Estates', publisher: { '@id': origin + '/#organization' }, inLanguage: ['es', 'en'] },
  { '@type': 'WebPage', '@id': origin + p.route + '#webpage', url: origin + p.route, name: p.title, description: p.description, inLanguage: p.lang, isPartOf: { '@id': origin + '/#website' } },
];
if (['GESTION', 'REFORMA', 'VENTA', 'LLEGADA', 'INVERSION'].includes(p.id)) graph.push({ '@type': 'Service', name: p.blocks[0].nodes.find(n => n.type === 'h1')?.text, serviceType: p.name, areaServed: p.id === 'INVERSION' ? { '@type': 'AdministrativeArea', name: 'Catalonia' } : { '@type': 'City', name: 'Barcelona' }, provider: { '@id': origin + '/#organization' }, url: origin + p.route });
if (article) graph.push({ '@type': 'BlogPosting', '@id': origin + p.route + '#article', headline: article.heading, description: article.description, datePublished: article.publishDate, dateModified: article.updatedDate, inLanguage: p.lang, image: shareImage, author: { '@type': article.author === 'Solera Estates' ? 'Organization' : 'Person', name: article.author }, publisher: { '@id': origin + '/#organization' }, mainEntityOfPage: { '@id': origin + p.route + '#webpage' } });
if (p.id === 'BLOG') graph.push({ '@type': 'Blog', name: 'Solera Estates Blog', url: origin + p.route, inLanguage: p.lang, publisher: { '@id': origin + '/#organization' } });
---
<!doctype html>
<html lang={p.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{p.title}</title>
    <meta name="description" content={p.description} />
    <meta name="robots" content={excludedFromIndex(p) ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={origin + p.route} />
    {Object.entries(alternates).map(([lang, route]) => <link rel="alternate" hreflang={lang} href={origin + route} />)}
    <link rel="alternate" hreflang="x-default" href={origin + (alternates.es || p.route)} />
    {(p.id === 'BLOG' || article) && <link rel="alternate" type="application/rss+xml" title="Solera Estates Blog" href={p.lang === 'es' ? '/blog/rss.xml' : '/en/blog/rss.xml'} />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {article && <><meta property="article:published_time" content={article.publishDate} /><meta property="article:modified_time" content={article.updatedDate} /></>}
    <meta property="og:title" content={p.title} />
    <meta property="og:description" content={p.description} />
    <meta property="og:url" content={origin + p.route} />
    <meta property="og:locale" content={p.lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta name="theme-color" content="#263e36" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/assets/serif.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')} />
    <script>import '../app.js';</script>
  </head>
  <body id="top" class={`page-${p.id.toLowerCase()}`}>
    <Header page={p} />
    <main id="main"><slot /></main>
    <Footer page={p} />
    <PrivacyControls lang={p.lang} />
  </body>
</html>
