---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PropertyCard from '../components/PropertyCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { getFeaturedProperties, formatPrice } from '../data/properties';
import { getLatestPosts } from '../data/blog';

const featuredProperties = getFeaturedProperties();
const latestPosts = getLatestPosts(3);

const stats = [
  { value: 15, suffix: '+', label: 'Años de experiencia' },
  { value: 850, suffix: '+', label: 'Propiedades vendidas' },
  { value: 98, suffix: '%', label: 'Clientes satisfechos' },
  { value: 500, suffix: 'M+', label: 'En transacciones (€)' },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  "name": "Solera Estates",
  "description": "Agencia inmobiliaria de lujo en Barcelona. Especialistas en pisos, áticos, villas y propiedades de lujo en los mejores barrios de la ciudad.",
  "url": "https://soleraestates.com",
  "telephone": "+34 93 000 00 00",
  "email": "info@soleraestates.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Passeig de Gràcia, 42",
    "addressLocality": "Barcelona",
    "addressRegion": "Cataluña",
    "postalCode": "08007",
    "addressCountry": "ES"
  },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "19:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "10:00", "closes": "14:00" }
  ],
  "priceRange": "€€€",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "127"
  }
};
---

<Layout
  title="Solera Estates | Inmobiliaria de Lujo en Barcelona"
  description="Solera Estates: tu agencia inmobiliaria de confianza en Barcelona. Expertos en pisos, áticos, villas y propiedades de lujo en Eixample, Gràcia, Sarrià y Barceloneta. +15 años de experiencia."
  canonical="/"
  schema={schema}
>
  <Header />

  <main id="main-content">

    <!-- ===== HERO ===== -->
    <section class="relative min-h-screen flex items-center overflow-hidden bg-cream pt-20" aria-labelledby="hero-title">
      <!-- Background decoration -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-gold-pale/60 blur-3xl"></div>
        <div class="absolute -bottom-20 -left-20 w-[400px] h-[400px] rounded-full bg-navy/5 blur-3xl"></div>
      </div>

      <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-24 w-full">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

          <!-- Left: Text + Search -->
          <div class="relative z-10">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2 bg-gold-pale border border-gold/30 text-navy text-xs font-semibold px-4 py-2 rounded-full mb-6" data-animate>
              <span class="w-2 h-2 rounded-full bg-gold animate-pulse inline-block"></span>
              #1 Agencia Inmobiliaria de Lujo en Barcelona
            </div>

            <h1 id="hero-title" class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold text-dark leading-tight mb-6" data-animate data-animate-delay="1">
              Tu Propiedad de<br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-navy via-navy-light to-gold">
                Ensueño en Barcelona
              </span>
            </h1>

            <p class="text-lg text-muted leading-relaxed max-w-lg mb-8" data-animate data-animate-delay="2">
              Expertos en propiedades exclusivas en los barrios más cotizados de Barcelona. Pisos, áticos, villas y lofts de lujo. Más de 15 años haciendo realidad los sueños de nuestros clientes.
            </p>

            <!-- Search Form -->
            <form
              action="/propiedades"
              method="GET"
              class="bg-white rounded-2xl shadow-lg border border-cream-dark/80 p-4 mb-8"
              data-animate
              data-animate-delay="3"
              aria-label="Buscador de propiedades"
            >
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-3">
                <div>
                  <label for="search-type" class="block text-xs font-semibold text-navy mb-1.5 uppercase tracking-wide">Tipo</label>
                  <select id="search-type" name="tipo" class="w-full bg-cream rounded-xl px-3 py-2.5 text-sm text-dark border border-cream-dark/60 focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold">
                    <option value="">Todos</option>
                    <option value="piso">Piso</option>
                    <option value="atico">Ático</option>
                    <option value="villa">Villa</option>
                    <option value="loft">Loft</option>
                    <option value="apartamento">Apartamento</option>
                  </select>
                </div>
                <div>
                  <label for="search-barrio" class="block text-xs font-semibold text-navy mb-1.5 uppercase tracking-wide">Barrio</label>
                  <select id="search-barrio" name="barrio" class="w-full bg-cream rounded-xl px-3 py-2.5 text-sm text-dark border border-cream-dark/60 focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold">
                    <option value="">Todos los barrios</option>
                    <option value="eixample">Eixample</option>
                    <option value="gracia">Gràcia</option>
                    <option value="sarria">Sarrià</option>
                    <option value="barceloneta">Barceloneta</option>
                    <option value="born">El Born</option>
                    <option value="poblenou">Poblenou</option>
                    <option value="pedralbes">Pedralbes</option>
                    <option value="les-corts">Les Corts</option>
                  </select>
                </div>
                <div>
                  <label for="search-price" class="block text-xs font-semibold text-navy mb-1.5 uppercase tracking-wide">Precio máx.</label>
                  <select id="search-price" name="precio" class="w-full bg-cream rounded-xl px-3 py-2.5 text-sm text-dark border border-cream-dark/60 focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold">
                    <option value="">Sin límite</option>
                    <option value="300000">Hasta 300.000€</option>
                    <option value="500000">Hasta 500.000€</option>
                    <option value="800000">Hasta 800.000€</option>
                    <option value="1500000">Hasta 1.500.000€</option>
                    <option value="3000000">Hasta 3.000.000€</option>
                  </select>
                </div>
              </div>
              <button type="submit" class="btn-gold w-full text-white font-semibold py-3 rounded-xl text-sm tracking-wide flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                Buscar Propiedades
              </button>
            </form>

            <!-- Trust Signals -->
            <div class="flex flex-wrap items-center gap-6" data-animate data-animate-delay="4">
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-gold" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                <span class="text-sm font-semibold text-dark">4.9/5</span>
                <span class="text-xs text-muted">(+127 reseñas)</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <span class="text-xs text-muted">Agente API Oficial</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span class="text-xs text-muted">+850 familias felices</span>
              </div>
            </div>
          </div>

          <!-- Right: Hero Image with floating cards -->
          <div class="relative hidden lg:block" data-animate data-animate-delay="2">
            <!-- Main Image -->
            <div class="relative rounded-3xl overflow-hidden shadow-2xl">
              <img
                src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=900&h=700&q=85"
                alt="Villa de lujo en Barcelona con piscina - Solera Estates"
                width="900"
                height="700"
                class="w-full object-cover"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-br from-navy/10 to-transparent"></div>
            </div>

            <!-- Floating Card 1: Price -->
            <div class="absolute -bottom-6 -left-8 bg-white rounded-2xl shadow-xl p-4 w-52 animate-[float_4s_ease-in-out_infinite]">
              <p class="text-xs text-muted mb-1">Precio medio Eixample</p>
              <p class="text-xl font-display font-bold text-navy">5.800€<span class="text-sm font-sans font-normal text-muted">/m²</span></p>
              <div class="flex items-center gap-1 mt-1">
                <svg class="w-3 h-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M3.293 9.707a1 1 0 010-1.414l6-6a1 1 0 011.414 0l6 6a1 1 0 01-1.414 1.414L11 5.414V17a1 1 0 11-2 0V5.414L4.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-xs text-emerald-600 font-medium">+4.2% vs 2025</span>
              </div>
            </div>

            <!-- Floating Card 2: New listing -->
            <div class="absolute -top-4 -right-6 bg-white rounded-2xl shadow-xl p-4 w-48 animate-[float_4s_ease-in-out_infinite_1s]">
              <div class="flex items-center gap-2 mb-2">
                <div class="w-8 h-8 rounded-xl bg-gold-pale flex items-center justify-center">
                  <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                  </svg>
                </div>
                <p class="text-xs font-semibold text-navy">Nueva propiedad</p>
              </div>
              <p class="text-xs text-muted">Ático Eixample</p>
              <p class="text-sm font-bold text-dark mt-0.5">850.000€</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce" aria-hidden="true">
        <span class="text-xs text-muted uppercase tracking-widest">Explorar</span>
        <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </div>
    </section>

    <!-- ===== STATS ===== -->
    <section id="stats" class="bg-navy py-16" aria-labelledby="stats-title">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
          {stats.map((stat, i) => (
            <div class="text-center" data-animate data-animate-delay={String(i + 1)}>
              <p class="text-4xl lg:text-5xl font-display font-bold text-white mb-2">
                <span data-counter={stat.value} data-suffix={stat.suffix}>0{stat.suffix}</span>
              </p>
              <p class="text-sm text-cream/60 uppercase tracking-widest">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== FEATURED PROPERTIES ===== -->
    <section class="py-20 lg:py-28 bg-cream" aria-labelledby="featured-title">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
          <div data-animate>
            <p class="text-sm font-semibold text-gold uppercase tracking-widest mb-3">Propiedades Destacadas</p>
            <h2 id="featured-title" class="font-display text-3xl lg:text-4xl font-bold text-dark section-title-accent">
              Las Mejores Propiedades<br/>de Barcelona
            </h2>
          </div>
          <a href="/propiedades" class="btn-gold text-white font-semibold px-8 py-3 rounded-full text-sm shrink-0 self-start md:self-auto" data-animate data-animate-delay="2">
            Ver todas →
          </a>
        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredProperties.slice(0, 6).map((property, i) => (
            <PropertyCard property={property} delay={i + 1} />
          ))}
        </div>
      </div>
    </section>

    <!-- ===== WHY US ===== -->
    <section class="py-20 lg:py-28 bg-white" aria-labelledby="why-us-title">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <!-- Image -->
          <div class="relative" data-animate>
            <div class="rounded-3xl overflow-hidden shadow-xl">
              <img
                src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=800&h=600&q=80"
                alt="Propiedad de lujo en Barcelona con piscina - Solera Estates"
                width="800"
                height="600"
                loading="lazy"
                class="w-full object-cover"
              />
            </div>
            <!-- Accent decoration -->
            <div class="absolute -bottom-4 -right-4 w-32 h-32 rounded-2xl bg-gold-pale border-2 border-gold/20 -z-10"></div>
            <div class="absolute -top-4 -left-4 w-20 h-20 rounded-xl bg-navy/5 -z-10"></div>

            <!-- Badge -->
            <div class="absolute top-6 right-6 bg-white rounded-2xl shadow-lg p-4 text-center">
              <p class="text-3xl font-display font-bold text-navy">15+</p>
              <p class="text-xs text-muted leading-tight">Años en<br/>Barcelona</p>
            </div>
          </div>

          <!-- Content -->
          <div data-animate data-animate-delay="2">
            <p class="text-sm font-semibold text-gold uppercase tracking-widest mb-3">Por Qué Elegirnos</p>
            <h2 id="why-us-title" class="font-display text-3xl lg:text-4xl font-bold text-dark mb-6 section-title-accent">
              La Agencia que Pone tus Intereses Primero
            </h2>
            <p class="text-muted leading-relaxed mb-8">
              En Solera Estates no vendemos propiedades: creamos experiencias de compra memorables. Nuestro enfoque personalizado, el conocimiento profundo del mercado barcelonés y nuestro compromiso ético nos distinguen desde 2010.
            </p>

            <ul class="space-y-5">
              {[
                {
                  icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
                  title: 'Agentes API Certificados',
                  desc: 'Todo nuestro equipo son Agentes de la Propiedad Inmobiliaria registrados y colegiados en Barcelona.',
                },
                {
                  icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
                  title: 'Alcance Internacional',
                  desc: 'Presencia en más de 15 países para conectar compradores internacionales con las mejores propiedades de Barcelona.',
                },
                {
                  icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
                  title: 'Valoraciones Precisas',
                  desc: 'Tasaciones gratuitas basadas en datos reales de mercado. Conocemos cada transacción en cada barrio.',
                },
                {
                  icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>`,
                  title: 'Servicio 360°',
                  desc: 'Te acompañamos en todo el proceso: búsqueda, negociación, financiación, notaría y postventa.',
                },
              ].map((item, i) => (
                <li class="flex gap-4" data-animate data-animate-delay={String(i + 1)}>
                  <div class="w-10 h-10 rounded-xl bg-gold-pale flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon}></svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-dark mb-1">{item.title}</h3>
                    <p class="text-sm text-muted leading-relaxed">{item.desc}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== NEIGHBORHOODS ===== -->
    <section class="py-20 bg-cream-dark" aria-labelledby="neighborhoods-title">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <div class="text-center mb-12" data-animate>
          <p class="text-sm font-semibold text-gold uppercase tracking-widest mb-3">Barrios de Barcelona</p>
          <h2 id="neighborhoods-title" class="font-display text-3xl lg:text-4xl font-bold text-dark section-title-accent centered">
            Los Mejores Barrios para Vivir e Invertir
          </h2>
          <p class="text-muted mt-6 max-w-2xl mx-auto">
            Cada barrio de Barcelona tiene su personalidad única. Descubre cuál encaja mejor con tu estilo de vida.
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {[
            { name: 'Eixample', slug: 'eixample', img: 'https://images.unsplash.com/photo-1583422409516-2895a77efaad?auto=format&fit=crop&w=400&h=280&q=80', desc: 'Modernismo y elegancia' },
            { name: 'Gràcia', slug: 'gracia', img: 'https://images.unsplash.com/photo-1564415315949-7a0c4c73aab4?auto=format&fit=crop&w=400&h=280&q=80', desc: 'Bohemio y familiar' },
            { name: 'Sarrià', slug: 'sarria', img: 'https://images.unsplash.com/photo-1568605114967-8130f3a36994?auto=format&fit=crop&w=400&h=280&q=80', desc: 'Exclusivo y tranquilo' },
            { name: 'Barceloneta', slug: 'barceloneta', img: 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=400&h=280&q=80', desc: 'Frente al mar' },
            { name: 'El Born', slug: 'born', img: 'https://images.unsplash.com/photo-1560185127-6a8ef3fd57e0?auto=format&fit=crop&w=400&h=280&q=80', desc: 'Trendy y cultural' },
            { name: 'Poblenou', slug: 'poblenou', img: 'https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=400&h=280&q=80', desc: 'Tech y creativo' },
            { name: 'Pedralbes', slug: 'pedralbes', img: 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=400&h=280&q=80', desc: 'Lujo y privacidad' },
            { name: 'Les Corts', slug: 'les-corts', img: 'https://images.unsplash.com/photo-1613977257363-707ba9348227?auto=format&fit=crop&w=400&h=280&q=80', desc: 'Residencial premium' },
          ].map((barrio, i) => (
            <a
              href={`/propiedades?barrio=${barrio.slug}`}
              class="group relative rounded-2xl overflow-hidden aspect-[4/3] shadow-sm hover:shadow-lg transition-all duration-300"
              data-animate
              data-animate-delay={String((i % 4) + 1)}
              aria-label={`Propiedades en ${barrio.name}`}
            >
              <img
                src={barrio.img}
                alt={`${barrio.name} Barcelona - Solera Estates`}
                loading="lazy"
                width="400"
                height="280"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-dark/70 via-dark/20 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-4">
                <p class="text-white font-semibold font-display text-lg leading-tight">{barrio.name}</p>
                <p class="text-white/70 text-xs">{barrio.desc}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== TEAM PREVIEW ===== -->
    <section class="py-20 lg:py-28 bg-white" aria-labelledby="team-preview-title">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <div class="text-center mb-12" data-animate>
