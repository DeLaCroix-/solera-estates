        </div>

        <div class="text-center">
          <a href="/equipo" class="inline-flex items-center gap-2 text-sm font-semibold text-navy hover:text-gold transition-colors border-b border-navy/30 hover:border-gold pb-1">
            Conocer todo el equipo →
          </a>
        </div>
      </div>
