              <span class="w-1.5 h-1.5 rounded-full bg-gold animate-pulse inline-block"></span>
              Consulta Gratuita · Sin Compromiso
            </div>

            <h2 id="cta-title" class="font-display text-3xl lg:text-5xl font-bold text-white leading-tight mb-5">
              Encuentra tu propiedad ideal<br/>
              <span class="text-gold">en Barcelona</span><br/>
              hoy mismo
            </h2>

            <p class="text-cream/70 text-lg leading-relaxed mb-8 max-w-lg">
              Nuestro equipo de agentes API en Barcelona te responde en menos de 2 horas. Compra, vende o invierte con los expertos.
            </p>

            <!-- Trust items -->
            <ul class="space-y-4 mb-10">
              {[
                { text: 'Respuesta garantizada en menos de 2 horas', icon: '✅' },
                { text: 'Valoración gratuita de tu propiedad en Barcelona', icon: '✅' },
                { text: '+850 familias satisfechas en Barcelona', icon: '✅' },
                { text: 'Agentes API colegiados y certificados', icon: '✅' },
              ].map(item => (
                <li class="flex items-center gap-3 text-cream/80 text-sm">
                  <span class="text-base">{item.icon}</span>
                  {item.text}
                </li>
              ))}
            </ul>

            <!-- Direct contacts -->
            <div class="flex flex-wrap gap-3">
              <a href="tel:+34623446002"
                 class="flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white text-sm font-semibold px-5 py-3 rounded-full transition-all duration-300">
                <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                Llámanos
              </a>
              <a href="https://wa.me/34623446002"
                 target="_blank" rel="noopener noreferrer"
                 class="flex items-center gap-2 bg-emerald-500/90 hover:bg-emerald-500 text-white text-sm font-semibold px-5 py-3 rounded-full transition-all duration-300">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                WhatsApp
              </a>
            </div>
          </div>

          <!-- Right: Formulario espectacular -->
          <div data-animate data-animate-delay="2">
            <div class="relative">
              <!-- Glow effect behind card -->
              <div class="absolute -inset-4 bg-gold/10 rounded-3xl blur-2xl pointer-events-none"></div>

              <div class="relative bg-white rounded-3xl shadow-2xl overflow-hidden">
                <!-- Card header gradient -->
                <div class="bg-gradient-to-r from-navy to-navy-light px-7 py-5">
                  <h3 class="text-white font-display text-xl font-bold mb-0.5">Escríbenos ahora</h3>
                  <p class="text-cream/60 text-sm">Te respondemos en menos de 2 horas</p>
                </div>

                <!-- Form body -->
                <form id="home-contact-form" class="px-7 py-6 space-y-4" aria-label="Formulario de contacto rápido">

                  <div class="grid grid-cols-2 gap-4">
                    <div>
                      <label for="hc-nombre" class="block text-xs font-bold text-navy uppercase tracking-wider mb-1.5">Nombre *</label>
                      <input
                        id="hc-nombre" type="text" name="nombre" required
                        placeholder="Tu nombre"
                        class="w-full bg-cream rounded-xl px-4 py-3 text-sm text-dark border border-cream-dark focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all placeholder-muted/40"
                      />
                    </div>
                    <div>
                      <label for="hc-tel" class="block text-xs font-bold text-navy uppercase tracking-wider mb-1.5">Teléfono *</label>
                      <input
                        id="hc-tel" type="tel" name="telefono" required
                        placeholder="+34 600 000 000"
                        class="w-full bg-cream rounded-xl px-4 py-3 text-sm text-dark border border-cream-dark focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all placeholder-muted/40"
                      />
                    </div>
                  </div>

                  <div>
                    <label for="hc-email" class="block text-xs font-bold text-navy uppercase tracking-wider mb-1.5">Email *</label>
                    <input
                      id="hc-email" type="email" name="email" required
                      placeholder="tu@email.com"
                      class="w-full bg-cream rounded-xl px-4 py-3 text-sm text-dark border border-cream-dark focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all placeholder-muted/40"
                    />
                  </div>

                  <div>
                    <label for="hc-interes" class="block text-xs font-bold text-navy uppercase tracking-wider mb-1.5">Me interesa</label>
                    <div class="grid grid-cols-2 gap-2" id="interest-group" role="group" aria-label="Tipo de consulta">
                      {['Comprar', 'Vender', 'Invertir', 'Valoración'].map(opt => (
                        <label class="interest-option flex items-center gap-2.5 bg-cream border border-cream-dark rounded-xl px-3 py-2.5 cursor-pointer hover:border-gold hover:bg-gold-pale transition-all text-sm text-dark font-medium">
                          <input type="radio" name="interes" value={opt.toLowerCase()} class="accent-gold w-3.5 h-3.5" />
                          {opt}
                        </label>
                      ))}
                    </div>
                  </div>

                  <div>
                    <label for="hc-mensaje" class="block text-xs font-bold text-navy uppercase tracking-wider mb-1.5">Mensaje</label>
                    <textarea
                      id="hc-mensaje" name="mensaje" rows="3"
                      placeholder="Cuéntanos qué buscas: barrio, presupuesto, tipo de propiedad..."
                      class="w-full bg-cream rounded-xl px-4 py-3 text-sm text-dark border border-cream-dark focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all resize-none placeholder-muted/40"
                    ></textarea>
                  </div>

                  <!-- Submit -->
                  <button
                    type="submit"
                    id="hc-submit"
                    class="btn-gold w-full text-white font-bold py-4 rounded-xl text-sm tracking-wide flex items-center justify-center gap-2 group"
                  >
                    <span>Enviar consulta gratuita</span>
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                  </button>

                  <!-- Success state -->
                  <div id="hc-success" class="hidden bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
                    <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-2">
                      <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                    </div>
                    <p class="text-emerald-700 font-semibold text-sm">¡Mensaje recibido!</p>
                    <p class="text-emerald-600 text-xs mt-1">Te contactamos antes de 2 horas.</p>
                  </div>

                  <p class="text-xs text-muted text-center">
                    🔒 Tus datos están protegidos · Sin spam · Sin compromiso
                  </p>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <script>
      document.getElementById('home-contact-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const btn = document.getElementById('hc-submit') as HTMLButtonElement;
        const success = document.getElementById('hc-success');
        if (btn) btn.style.display = 'none';
        success?.classList.remove('hidden');
      });
    </script>

  </main>

  <Footer />
</Layout>
