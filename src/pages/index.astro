            {
              name: 'Jorge Navarro',
              role: 'Director Comercial',
              bio: 'Experto en operaciones de compraventa y negociación. Especializado en inversores nacionales e internacionales.',
              img: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=400&h=400&q=80',
              linkedin: '#',
            },
            {
