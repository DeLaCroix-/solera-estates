---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contacto - Solera Estates Barcelona",
  "description": "Contacta con Solera Estates, tu agencia inmobiliaria de confianza en Barcelona.",
  "url": "https://soleraestates.com/contacto",
  "mainEntity": {
    "@type": "RealEstateAgent",
    "name": "Solera Estates",
    "telephone": "+34930000000",
    "email": "info@soleraestates.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Passeig de Gràcia, 42",
      "addressLocality": "Barcelona",
      "postalCode": "08007",
      "addressCountry": "ES"
    }
  }
};
---

<Layout
  title="Contacto | Solera Estates - Agencia Inmobiliaria Barcelona"
  description="Contacta con Solera Estates en Barcelona. Llámanos, escríbenos o visítanos en Passeig de Gràcia 42. Consulta gratuita y sin compromiso sobre compra, venta o inversión inmobiliaria."
  canonical="/contacto"
  schema={schema}
>
  <Header />

  <main class="pt-20">

    <!-- Hero -->
    <section class="bg-gradient-to-br from-navy to-navy-light py-16 lg:py-20" aria-labelledby="contact-title">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 text-center">
        <p class="text-gold text-sm font-semibold uppercase tracking-widest mb-3" data-animate>Estamos Aquí para Ayudarte</p>
        <h1 id="contact-title" class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4" data-animate data-animate-delay="1">
          Contacta con Nosotros
        </h1>
        <p class="text-cream/70 max-w-xl mx-auto" data-animate data-animate-delay="2">
          Consulta gratuita y sin compromiso. Nuestro equipo de expertos está disponible para resolver todas tus dudas sobre el mercado inmobiliario barcelonés.
        </p>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-16 lg:py-20 bg-cream">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

          <!-- Left: Info -->
          <div class="lg:col-span-1 space-y-6">

            <!-- Office Image -->
            <div class="rounded-2xl overflow-hidden shadow-lg" data-animate>
              <img
                src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=600&h=350&q=80"
                alt="Oficina de Solera Estates en Barcelona"
                width="600"
                height="350"
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>

            <!-- Contact Details -->
            <div class="bg-white rounded-2xl border border-cream-dark p-6" data-animate data-animate-delay="1">
              <h2 class="font-display text-lg font-bold text-dark mb-5">Información de Contacto</h2>
              <ul class="space-y-4">
                <li class="flex items-start gap-3">
                  <div class="w-9 h-9 rounded-xl bg-gold-pale flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-navy uppercase tracking-wide mb-1">Dirección</p>
                    <p class="text-sm text-muted">Passeig de Gràcia, 42<br/>08007 Barcelona, España</p>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <div class="w-9 h-9 rounded-xl bg-gold-pale flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-navy uppercase tracking-wide mb-1">Teléfono</p>
                    <a href="tel:+34930000000" class="text-sm text-muted hover:text-gold transition-colors">+34 93 000 00 00</a>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <div class="w-9 h-9 rounded-xl bg-gold-pale flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-navy uppercase tracking-wide mb-1">Email</p>
                    <a href="mailto:info@soleraestates.com" class="text-sm text-muted hover:text-gold transition-colors">info@soleraestates.com</a>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <div class="w-9 h-9 rounded-xl bg-gold-pale flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-navy uppercase tracking-wide mb-1">Horario</p>
                    <p class="text-sm text-muted">Lun–Vie: 9:00–19:00<br/>Sábado: 10:00–14:00</p>
                  </div>
                </li>
              </ul>
            </div>

            <!-- WhatsApp CTA -->
            <a
              href="https://wa.me/34930000000"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 bg-emerald-500 hover:bg-emerald-600 text-white font-semibold py-4 px-6 rounded-2xl transition-colors shadow-md"
              data-animate
              data-animate-delay="2"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <div>
                <p class="text-sm">Chat por WhatsApp</p>
                <p class="text-xs text-white/70">Respuesta inmediata</p>
              </div>
            </a>
          </div>

          <!-- Right: Form -->
          <div class="lg:col-span-2">
            <div class="bg-white rounded-3xl border border-cream-dark shadow-sm p-8 lg:p-10" data-animate data-animate-delay="1">
              <h2 class="font-display text-2xl font-bold text-dark mb-2">Envíanos un Mensaje</h2>
              <p class="text-muted text-sm mb-8">Rellena el formulario y uno de nuestros agentes se pondrá en contacto contigo en menos de 24 horas.</p>

              <form id="contact-form" class="space-y-5" aria-label="Formulario de contacto">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div>
                    <label for="nombre" class="block text-xs font-semibold text-navy uppercase tracking-wide mb-2">Nombre *</label>
                    <input id="nombre" type="text" name="nombre" required placeholder="Tu nombre completo"
                      class="w-full bg-cream rounded-xl px-4 py-3 text-sm text-dark border border-cream-dark focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all" />
                  </div>
                  <div>
                    <label for="email" class="block text-xs font-semibold text-navy uppercase tracking-wide mb-2">Email *</label>
                    <input id="email" type="email" name="email" required placeholder="tu@email.com"
                      class="w-full bg-cream rounded-xl px-4 py-3 text-sm text-dark border border-cream-dark focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all" />
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div>
                    <label for="telefono" class="block text-xs font-semibold text-navy uppercase tracking-wide mb-2">Teléfono</label>
                    <input id="telefono" type="tel" name="telefono" placeholder="+34 600 000 000"
                      class="w-full bg-cream rounded-xl px-4 py-3 text-sm text-dark border border-cream-dark focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all" />
                  </div>
                  <div>
                    <label for="asunto" class="block text-xs font-semibold text-navy uppercase tracking-wide mb-2">Asunto *</label>
                    <select id="asunto" name="asunto" required
                      class="w-full bg-cream rounded-xl px-4 py-3 text-sm text-dark border border-cream-dark focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all">
                      <option value="">Selecciona una opción</option>
                      <option value="comprar">Quiero comprar una propiedad</option>
                      <option value="vender">Quiero vender mi propiedad</option>
                      <option value="invertir">Quiero invertir en Barcelona</option>
                      <option value="valoracion">Solicitar valoración gratuita</option>
                      <option value="visita">Organizar una visita</option>
                      <option value="otro">Otro</option>
                    </select>
                  </div>
                </div>

                <div>
                  <label for="presupuesto" class="block text-xs font-semibold text-navy uppercase tracking-wide mb-2">Presupuesto aproximado</label>
                  <select id="presupuesto" name="presupuesto"
                    class="w-full bg-cream rounded-xl px-4 py-3 text-sm text-dark border border-cream-dark focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all">
                    <option value="">Prefiero no indicarlo</option>
                    <option value="hasta300k">Hasta 300.000€</option>
                    <option value="300-600k">300.000€ - 600.000€</option>
                    <option value="600k-1m">600.000€ - 1.000.000€</option>
                    <option value="1-3m">1.000.000€ - 3.000.000€</option>
                    <option value="mas3m">Más de 3.000.000€</option>
                  </select>
                </div>

                <div>
                  <label for="mensaje" class="block text-xs font-semibold text-navy uppercase tracking-wide mb-2">Mensaje *</label>
                  <textarea id="mensaje" name="mensaje" rows="5" required
                    placeholder="Cuéntanos qué tipo de propiedad buscas, tus necesidades, barrio preferido, etc."
                    class="w-full bg-cream rounded-xl px-4 py-3 text-sm text-dark border border-cream-dark focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all resize-none"></textarea>
                </div>

                <div class="flex items-start gap-3">
                  <input id="privacidad" type="checkbox" required class="mt-1 w-4 h-4 accent-gold" />
                  <label for="privacidad" class="text-xs text-muted leading-relaxed">
                    Acepto la <a href="/privacidad" class="text-gold hover:underline">política de privacidad</a> y el tratamiento de mis datos para gestionar esta consulta. Nunca compartiré tus datos con terceros.
                  </label>
                </div>

                <button type="submit" class="btn-gold w-full text-white font-semibold py-4 rounded-xl text-base">
                  Enviar Mensaje →
                </button>

                <!-- Success message (hidden) -->
                <div id="success-msg" class="hidden bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
                  <svg class="w-8 h-8 text-emerald-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <p class="text-emerald-700 font-semibold text-sm">¡Mensaje enviado con éxito!</p>
                  <p class="text-emerald-600 text-xs mt-1">Te contactaremos en menos de 24 horas.</p>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Map -->
    <section class="py-0 bg-cream" aria-label="Nuestra ubicación en Barcelona">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 pb-16">
        <div class="rounded-3xl overflow-hidden shadow-lg bg-cream-dark h-72 flex items-center justify-center relative">
          <div class="text-center z-10">
            <div class="w-16 h-16 rounded-full bg-navy flex items-center justify-center mx-auto mb-4 shadow-lg">
              <svg class="w-8 h-8 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <p class="font-display text-xl font-bold text-dark">Passeig de Gràcia, 42</p>
            <p class="text-muted text-sm mb-4">08007 Barcelona, España</p>
            <a
              href="https://maps.google.com/?q=Passeig+de+Gracia+42+Barcelona"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-gold text-white text-sm font-semibold px-6 py-2.5 rounded-full inline-flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
              </svg>
              Cómo llegar
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    // Simulate form submission
    const successMsg = document.getElementById('success-msg');
    const submitBtn = document.querySelector('#contact-form button[type="submit"]') as HTMLButtonElement;
    if (submitBtn) submitBtn.style.display = 'none';
    successMsg?.classList.remove('hidden');
  });
</script>
