---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacta con Solera Estates | Inmobiliaria en Barcelona"
  description="Ponte en contacto con Solera Estates. Estaremos encantados de ayudarte a encontrar la propiedad perfecta en Barcelona. Passeig de Gràcia, 123 · +34 932 123 456"
  canonical="https://soleraestates.com/contacto"
>
  <section class="pt-32 pb-8 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-12 animate-fade-up">
        <h1 class="section-title text-white">Contacta con Solera Estates</h1>
        <p class="section-subtitle mx-auto mt-4">
          Estamos aquí para ayudarte a encontrar el hogar de tus sueños en Barcelona
        </p>
      </div>
    </div>
  </section>

  <section class="pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-10">
        <!-- Form -->
        <div class="glass-card p-8 md:p-10 animate-fade-up">
          <h2 class="text-white font-heading font-semibold text-2xl mb-6">Envíanos un mensaje</h2>
          <form id="contactPageForm" class="space-y-5">
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="nombre" class="block text-sm text-slate-300 mb-1.5 font-medium">Nombre completo *</label>
                <input type="text" id="nombre" required placeholder="Tu nombre" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700/50 text-slate-200 text-sm focus:outline-none focus:border-solera-500 focus:ring-1 focus:ring-solera-500/30 transition-colors placeholder:text-slate-500"/>
              </div>
              <div>
                <label for="email" class="block text-sm text-slate-300 mb-1.5 font-medium">Email *</label>
                <input type="email" id="email" required placeholder="tu@email.com" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700/50 text-slate-200 text-sm focus:outline-none focus:border-solera-500 focus:ring-1 focus:ring-solera-500/30 transition-colors placeholder:text-slate-500"/>
              </div>
            </div>
            <div>
              <label for="telefono" class="block text-sm text-slate-300 mb-1.5 font-medium">Teléfono</label>
              <input type="tel" id="telefono" placeholder="+34 612 345 678" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700/50 text-slate-200 text-sm focus:outline-none focus:border-solera-500 focus:ring-1 focus:ring-solera-500/30 transition-colors placeholder:text-slate-500"/>
            </div>
            <div>
              <label for="interes" class="block text-sm text-slate-300 mb-1.5 font-medium">Estoy interesado en</label>
              <select id="interes" class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700/50 text-slate-200 text-sm focus:outline-none focus:border-solera-500 focus:ring-1 focus:ring-solera-500/30 transition-colors appearance-none">
                <option value="comprar">Comprar una propiedad</option>
                <option value="vender">Vender una propiedad</option>
                <option value="alquilar">Alquilar una propiedad</option>
                <option value="tasacion">Tasación</option>
                <option value="otros">Otros</option>
              </select>
            </div>
            <div>
              <label for="mensaje" class="block text-sm text-slate-300 mb-1.5 font-medium">Mensaje *</label>
              <textarea id="mensaje" rows="5" required placeholder="Cuéntanos qué estás buscando..." class="w-full px-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700/50 text-slate-200 text-sm focus:outline-none focus:border-solera-500 focus:ring-1 focus:ring-solera-500/30 transition-colors placeholder:text-slate-500 resize-none"></textarea>
            </div>
            <div class="flex items-start gap-3">
              <input type="checkbox" id="politica" required class="mt-1 rounded bg-slate-800 border-slate-700 text-solera-500 focus:ring-solera-500"/>
              <label for="politica" class="text-slate-400 text-xs">He leído y acepto la política de privacidad</label>
            </div>
            <button type="submit" class="btn-primary text-base px-8 py-4 w-full justify-center">
              Enviar mensaje
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
            </button>
          </form>
        </div>

        <!-- Info -->
        <div class="space-y-6 animate-fade-up" style="animation-delay: 0.2s">
          <div class="glass-card p-8">
            <h2 class="text-white font-heading font-semibold text-2xl mb-6">Información de contacto</h2>
            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-solera-500/10 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 text-solera-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </div>
                <div>
                  <h3 class="text-white font-heading font-semibold mb-1">Dirección</h3>
                  <p class="text-slate-400 text-sm leading-relaxed">Passeig de Gràcia, 123<br/>08008 Barcelona</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-solera-500/10 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 text-solera-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <div>
                  <h3 class="text-white font-heading font-semibold mb-1">Teléfono</h3>
                  <p class="text-slate-400 text-sm">+34 932 123 456</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-solera-500/10 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 text-solera-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <h3 class="text-white font-heading font-semibold mb-1">Email</h3>
                  <p class="text-slate-400 text-sm">info@soleraestates.com</p>
                </div>
              </div>
            </div>
          </div>

          <div class="glass-card p-8">
            <h2 class="text-white font-heading font-semibold text-2xl mb-4">Horario</h2>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between text-slate-300 pb-2 border-b border-slate-700/50"><span>Lunes – Viernes</span><span class="font-medium">09:00 – 19:00</span></div>
              <div class="flex justify-between text-slate-300 pb-2 border-b border-slate-700/50"><span>Sábado</span><span class="font-medium">10:00 – 14:00</span></div>
              <div class="flex justify-between text-slate-500"><span>Domingo</span><span>Cerrado</span></div>
            </div>
          </div>

          <div class="glass-card p-8">
            <h2 class="text-white font-heading font-semibold text-2xl mb-4">Ubicación</h2>
            <div class="h-48 rounded-xl bg-gradient-to-br from-slate-800 to-slate-900 flex items-center justify-center border border-slate-700/50">
              <div class="text-center">
                <svg class="w-10 h-10 text-solera-400 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span class="text-slate-500 text-xs">Passeig de Gràcia, 123 · 08008 Barcelona</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contactPageForm');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Gracias por contactar con Solera Estates. Te responderemos en menos de 24 horas.');
      form.reset();
    });
  }
</script>
