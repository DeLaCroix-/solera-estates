---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { blogPosts, formatDate } from '../../data/blog';

const [featured, ...rest] = blogPosts;

const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog Inmobiliario Barcelona - Solera Estates",
  "description": "Consejos, tendencias y guías del mercado inmobiliario de Barcelona.",
  "url": "https://soleraestates.com/blog",
  "inLanguage": "es",
  "publisher": {
    "@type": "Organization",
    "name": "Solera Estates",
    "url": "https://soleraestates.com"
  },
};
---

<Layout
  title="Blog Inmobiliario Barcelona | Consejos y Tendencias | Solera Estates"
  description="El blog de referencia del mercado inmobiliario en Barcelona. Guías para comprar, vender e invertir en propiedades. Análisis de barrios, precios y tendencias del sector."
  canonical="/blog"
  schema={schema}
>
  <Header />

  <main class="pt-20">

    <!-- Page Header -->
    <section class="bg-gradient-to-br from-navy to-navy-light py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 text-center">
        <p class="text-gold text-sm font-semibold uppercase tracking-widest mb-3" data-animate>Blog inmobiliario</p>
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4" data-animate data-animate-delay="1">
          Tendencias y consejos del<br/>mercado inmobiliario en Barcelona
        </h1>
        <p class="text-cream/70 max-w-xl mx-auto" data-animate data-animate-delay="2">
          Todo lo que necesitas saber para comprar, vender e invertir en propiedades en Barcelona con éxito.
        </p>

        <nav class="flex justify-center mt-6" aria-label="Migas de pan">
          <ol class="flex items-center gap-2 text-sm text-cream/50" itemscope itemtype="https://schema.org/BreadcrumbList">
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="/" class="hover:text-gold transition-colors" itemprop="item"><span itemprop="name">Inicio</span></a>
              <meta itemprop="position" content="1" />
            </li>
            <li aria-hidden="true"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="text-gold font-medium" itemprop="name">Blog</span>
              <meta itemprop="position" content="2" />
            </li>
          </ol>
        </nav>
      </div>
    </section>

    <!-- Featured Post -->
    {featured && (
      <section class="py-12 bg-cream" aria-label="Artículo destacado">
        <div class="max-w-7xl mx-auto px-6 lg:px-10">
          <p class="text-xs font-semibold text-gold uppercase tracking-widest mb-6" data-animate>Artículo destacado</p>
          <article class="group grid grid-cols-1 lg:grid-cols-2 gap-0 bg-white rounded-3xl overflow-hidden shadow-lg border border-cream-dark hover:shadow-xl transition-shadow duration-300" data-animate data-animate-delay="1">
            <!-- Image -->
            <a href={`/blog/${featured.slug}`} class="block overflow-hidden aspect-[16/10] lg:aspect-auto lg:min-h-[380px]">
              <img
                src={featured.image}
                alt={`${featured.title} - Blog Solera Estates`}
                width="800"
                height="500"
                loading="eager"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </a>
            <!-- Content -->
            <div class="p-8 lg:p-10 flex flex-col justify-center">
              <div class="flex items-center gap-3 mb-4">
                <span class="bg-emerald-100 text-emerald-700 text-xs font-semibold px-3 py-1.5 rounded-full">{featured.category}</span>
                <time class="text-xs text-muted" datetime={featured.date}>{formatDate(featured.date)}</time>
                <span class="text-xs text-muted">{featured.readTime} min</span>
              </div>
              <h2 class="font-display text-2xl lg:text-3xl font-bold text-dark mb-4 leading-tight group-hover:text-navy transition-colors">
                <a href={`/blog/${featured.slug}`}>{featured.title}</a>
              </h2>
              <p class="text-muted leading-relaxed mb-6 line-clamp-3">{featured.excerpt}</p>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-full bg-gradient-to-br from-navy to-navy-light flex items-center justify-center text-xs text-white font-bold">
                    {featured.author.split(' ').map((w: string) => w[0]).join('').slice(0, 2)}
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-dark">{featured.author}</p>
                    <p class="text-xs text-muted">{featured.authorRole}</p>
                  </div>
                </div>
                <a href={`/blog/${featured.slug}`} class="btn-gold text-white text-sm font-semibold px-6 py-2.5 rounded-full">
                  Leer artículo →
                </a>
              </div>
            </div>
          </article>
        </div>
      </section>
    )}

    <!-- All Posts Grid -->
    <section class="py-12 bg-cream" aria-labelledby="all-posts-title">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <h2 id="all-posts-title" class="font-display text-2xl font-bold text-dark mb-8 section-title-accent">Todos los artículos</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {rest.map((post, i) => (
            <BlogCard post={post} delay={i + 1} />
          ))}
        </div>
      </div>
    </section>

    <!-- Newsletter CTA -->
    <section class="py-16 bg-navy" aria-labelledby="newsletter-title">
      <div class="max-w-2xl mx-auto px-6 lg:px-10 text-center">
        <div data-animate>
          <svg class="w-12 h-12 text-gold mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <h2 id="newsletter-title" class="font-display text-2xl lg:text-3xl font-bold text-white mb-3">
            Recibe las últimas novedades del mercado
          </h2>
          <p class="text-cream/60 mb-8">Suscríbete y recibe análisis de mercado, nuevas propiedades y consejos de expertos directamente en tu bandeja de entrada.</p>
          <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" aria-label="Formulario de suscripción al newsletter">
            <label for="newsletter-email" class="sr-only">Tu email</label>
            <input
              id="newsletter-email"
              type="email"
              placeholder="tu@email.com"
              class="flex-1 bg-white/10 border border-white/20 text-white placeholder-cream/40 rounded-full px-5 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-gold/50"
              required
            />
            <button type="submit" class="btn-gold text-white font-semibold px-6 py-3 rounded-full text-sm shrink-0">
              Suscribirme
            </button>
          </form>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
