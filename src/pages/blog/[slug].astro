---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { blogPosts, getPostBySlug, formatDate } from '../../data/blog';

export async function getStaticPaths() {
  return blogPosts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const relatedPosts = blogPosts.filter(p => p.slug !== post.slug).slice(0, 3);

// Convert markdown-like content to HTML (simple version)
function parseContent(content: string): string {
  return content
    .trim()
    .split('\n')
    .map(line => {
      if (line.startsWith('## ')) return `<h2 class="font-display text-2xl font-bold text-dark mt-10 mb-4">${line.slice(3)}</h2>`;
      if (line.startsWith('### ')) return `<h3 class="font-display text-xl font-semibold text-dark mt-8 mb-3">${line.slice(4)}</h3>`;
      if (line.startsWith('#### ')) return `<h4 class="font-semibold text-dark mt-6 mb-2">${line.slice(5)}</h4>`;
      if (line.startsWith('- ')) return `<li class="ml-4 mb-1">${line.slice(2).replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}</li>`;
      if (line === '') return '<br/>';
      return `<p class="mb-4 text-muted leading-relaxed">${line.replace(/\*\*(.*?)\*\*/g, '<strong class="text-dark">$1</strong>')}</p>`;
    })
    .join('\n')
    .replace(/<\/li>\n<p/g, '</li>\n<ul class="list-disc list-outside mb-4 pl-4 space-y-1"><p')
    .replace(/<br\/>\n<li/g, '<ul class="list-disc list-outside mb-4 pl-4 space-y-1"><li');
}

const parsedContent = parseContent(post.content);

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.metaDescription,
  "image": post.image,
  "datePublished": post.date,
  "dateModified": post.date,
  "author": {
    "@type": "Person",
    "name": post.author,
    "jobTitle": post.authorRole,
    "worksFor": { "@type": "Organization", "name": "Solera Estates" }
  },
  "publisher": {
    "@type": "Organization",
    "name": "Solera Estates",
    "url": "https://soleraestates.com",
    "logo": { "@type": "ImageObject", "url": "https://soleraestates.com/favicon.svg" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://soleraestates.com/blog/${post.slug}` },
  "keywords": post.tags.join(', '),
  "inLanguage": "es",
  "about": { "@type": "Thing", "name": "Mercado inmobiliario Barcelona" },
};
---

<Layout
  title={`${post.title} | Blog Solera Estates Barcelona`}
  description={post.metaDescription}
  canonical={`/blog/${post.slug}`}
  ogImage={post.image}
  type="article"
  publishDate={post.date}
  schema={schema}
>
  <Header />

  <main class="pt-20">

    <!-- Article Hero -->
    <section class="relative" aria-label="Imagen del artículo">
      <div class="h-72 md:h-96 overflow-hidden">
        <img
          src={post.image}
          alt={`${post.title} - Blog Solera Estates`}
          width="1400"
          height="600"
          loading="eager"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-dark/60 via-dark/20 to-transparent"></div>
      </div>

      <!-- Category pill over image -->
      <div class="absolute top-6 left-1/2 -translate-x-1/2">
        <span class="bg-gold text-white text-xs font-bold px-4 py-2 rounded-full uppercase tracking-wide shadow-lg">
          {post.category}
        </span>
      </div>
    </section>

    <!-- Article Content -->
    <section class="py-12 bg-cream">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">

          <!-- Main Content -->
          <article class="lg:col-span-3">
            <!-- Breadcrumb -->
            <nav class="flex items-center gap-2 text-xs text-muted mb-8 flex-wrap" aria-label="Migas de pan">
              <a href="/" class="hover:text-navy transition-colors">Inicio</a>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              <a href="/blog" class="hover:text-navy transition-colors">Blog</a>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              <span class="text-navy font-medium truncate">{post.title}</span>
            </nav>

            <!-- Header -->
            <header class="mb-8">
              <div class="flex flex-wrap items-center gap-3 mb-4">
                {post.tags.slice(0, 3).map(tag => (
                  <span class="bg-cream-dark text-muted text-xs font-medium px-3 py-1 rounded-full">{tag}</span>
                ))}
              </div>

              <h1 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold text-dark leading-tight mb-4">
                {post.title}
              </h1>

              <p class="text-lg text-muted leading-relaxed mb-6">{post.excerpt}</p>

              <!-- Author + Meta -->
              <div class="flex flex-wrap items-center gap-6 p-4 bg-white rounded-2xl border border-cream-dark">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-gradient-to-br from-navy to-navy-light flex items-center justify-center text-sm text-white font-bold">
                    {post.author.split(' ').map((w: string) => w[0]).join('').slice(0, 2)}
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-dark">{post.author}</p>
                    <p class="text-xs text-gold">{post.authorRole} · Solera Estates</p>
                  </div>
                </div>
                <div class="flex items-center gap-1 text-xs text-muted">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  <time datetime={post.date}>{formatDate(post.date)}</time>
                </div>
                <div class="flex items-center gap-1 text-xs text-muted">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  {post.readTime} minutos de lectura
                </div>
              </div>
            </header>

            <!-- Article Body -->
            <div class="bg-white rounded-3xl p-6 md:p-10 shadow-sm border border-cream-dark prose-article">
              <Fragment set:html={parsedContent} />
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2 mt-8">
              <span class="text-xs font-semibold text-muted uppercase tracking-wide">Etiquetas:</span>
              {post.tags.map(tag => (
                <span class="text-xs bg-cream-dark text-muted px-3 py-1.5 rounded-full hover:bg-gold-pale hover:text-navy transition-colors cursor-pointer">{tag}</span>
              ))}
            </div>

            <!-- Share -->
            <div class="flex items-center gap-4 mt-8 p-5 bg-white rounded-2xl border border-cream-dark">
              <span class="text-sm font-semibold text-dark">Compartir:</span>
              <a href={`https://wa.me/?text=${encodeURIComponent(post.title + ' ' + 'https://soleraestates.com/blog/' + post.slug)}`}
                 target="_blank" rel="noopener noreferrer" aria-label="Compartir en WhatsApp"
                 class="w-9 h-9 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center hover:bg-emerald-500 hover:text-white transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
              </a>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent('https://soleraestates.com/blog/' + post.slug)}`}
                 target="_blank" rel="noopener noreferrer" aria-label="Compartir en LinkedIn"
                 class="w-9 h-9 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center hover:bg-blue-600 hover:text-white transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            </div>

            <!-- CTA -->
            <div class="mt-10 p-8 bg-gradient-to-br from-navy to-navy-light rounded-3xl text-center">
              <h3 class="font-display text-xl font-bold text-white mb-2">¿Buscas una propiedad en Barcelona?</h3>
              <p class="text-cream/70 text-sm mb-5">Nuestros expertos te ayudan a encontrar la propiedad ideal. Consulta gratuita y sin compromiso.</p>
              <div class="flex flex-col sm:flex-row gap-3 justify-center">
                <a href="/propiedades" class="btn-gold text-white font-semibold px-6 py-3 rounded-full text-sm">Ver Propiedades</a>
                <a href="/contacto" class="bg-white/10 border border-white/30 text-white font-semibold px-6 py-3 rounded-full text-sm hover:bg-white hover:text-navy transition-all">Hablar con un Agente</a>
              </div>
            </div>
          </article>

          <!-- Sidebar -->
          <aside class="lg:col-span-1">
            <div class="sticky top-28 space-y-6">
              <!-- About -->
              <div class="bg-white rounded-2xl border border-cream-dark p-5">
                <h3 class="font-semibold text-dark mb-3 text-sm">Sobre el Autor</h3>
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-12 h-12 rounded-full bg-gradient-to-br from-navy to-navy-light flex items-center justify-center text-white font-bold">
                    {post.author.split(' ').map((w: string) => w[0]).join('').slice(0, 2)}
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-dark">{post.author}</p>
                    <p class="text-xs text-gold">{post.authorRole}</p>
                  </div>
                </div>
                <p class="text-xs text-muted leading-relaxed">Experto en el mercado inmobiliario de Barcelona con más de 15 años de experiencia en compraventa de propiedades de lujo.</p>
              </div>

              <!-- Related Posts -->
              <div class="bg-white rounded-2xl border border-cream-dark p-5">
                <h3 class="font-semibold text-dark mb-4 text-sm">Artículos Relacionados</h3>
                <ul class="space-y-4">
                  {relatedPosts.slice(0, 3).map(related => (
                    <li>
                      <a href={`/blog/${related.slug}`} class="group flex gap-3">
                        <div class="w-16 h-14 rounded-xl overflow-hidden shrink-0">
                          <img src={related.image} alt={related.title} width="80" height="60" loading="lazy" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
                        </div>
                        <div>
                          <p class="text-xs font-semibold text-dark group-hover:text-navy transition-colors leading-snug line-clamp-2">{related.title}</p>
                          <p class="text-xs text-muted mt-1">{related.readTime} min</p>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Contact -->
              <div class="bg-navy rounded-2xl p-5 text-center">
                <svg class="w-10 h-10 text-gold mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <p class="text-white font-semibold text-sm mb-1">¿Tienes alguna pregunta?</p>
                <p class="text-cream/60 text-xs mb-4">Llámanos o escríbenos</p>
                <a href="tel:+34623446002" class="btn-gold block text-white text-xs font-semibold py-2.5 rounded-xl">
                  +34 623 446 002
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Related Posts Grid -->
    <section class="py-16 bg-cream-dark" aria-labelledby="related-blog-title">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <h2 id="related-blog-title" class="font-display text-2xl font-bold text-dark mb-8">Más Artículos del Blog</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedPosts.map((p, i) => <BlogCard post={p} delay={i + 1} />)}
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
