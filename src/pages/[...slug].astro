---
import { pages } from '../lib/site.mjs';
import EditorialPage from '../components/EditorialPage.astro';
export function getStaticPaths() {
  return pages.filter(page => page.route !== '/404/').map(page => ({ params: { slug: page.route.replace(/^\/|\/$/g, '') || undefined }, props: { page } }));
}
const { page } = Astro.props;
---
<EditorialPage page={page} />
