---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import { properties, getPropertyBySlug, formatPrice } from '../../data/properties';

export async function getStaticPaths() {
  return properties.map(p => ({ params: { slug: p.slug }, props: { property: p } }));
}

const { property } = Astro.props;
const otherProperties = properties.filter(p => p.slug !== property.slug).slice(0, 3);

const typeLabels: Record<string, string> = {
  atico: 'Ático', piso: 'Piso', villa: 'Villa',
  loft: 'Loft', apartamento: 'Apartamento', duplex: 'Dúplex',
};

const schema = {
  "@context": "https://schema.org",
  "@type": "RealEstateListing",
  "name": property.title,
  "description": property.description,
  "url": `https://soleraestates.com/propiedades/${property.slug}`,
  "image": property.gallery,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Barcelona",
    "addressRegion": "Cataluña",
    "addressCountry": "ES",
    "streetAddress": property.location,
  },
  "numberOfRooms": property.bedrooms,
  "floorSize": { "@type": "QuantitativeValue", "value": property.sqm, "unitCode": "MTK" },
  "offers": {
    "@type": "Offer",
    "price": property.price,
    "priceCurrency": "EUR",
    "availability": property.status === 'available' ? "https://schema.org/InStock" : "https://schema.org/SoldOut",
  },
};
---

<Layout
  title={`${property.title} | Solera Estates Barcelona`}
  description={`${property.description} ${property.sqm}m² · ${property.bedrooms} habitaciones · ${property.bathrooms} baños · ${formatPrice(property.price)}. Ref: ${property.reference}`}
  canonical={`/propiedades/${property.slug}`}
  ogImage={property.image}
  schema={schema}
>
  <Header />

  <main class="pt-20">

    <!-- Breadcrumb -->
    <div class="bg-cream-dark/50 border-b border-cream-dark py-3">
      <nav class="max-w-7xl mx-auto px-6 lg:px-10" aria-label="Migas de pan">
        <ol class="flex items-center gap-2 text-xs text-muted flex-wrap" itemscope itemtype="https://schema.org/BreadcrumbList">
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/" class="hover:text-navy transition-colors" itemprop="item"><span itemprop="name">Inicio</span></a>
            <meta itemprop="position" content="1" />
          </li>
          <li aria-hidden="true"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/propiedades" class="hover:text-navy transition-colors" itemprop="item"><span itemprop="name">Propiedades</span></a>
            <meta itemprop="position" content="2" />
          </li>
          <li aria-hidden="true"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li class="text-navy font-medium truncate max-w-xs" aria-current="page">{property.title}</li>
        </ol>
      </nav>
    </div>

    <!-- Hero Gallery -->
    <section class="bg-cream" aria-label="Galería de fotos">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-3 rounded-3xl overflow-hidden">
          <!-- Main image -->
          <div class="lg:col-span-3 aspect-[4/3] overflow-hidden">
            <img
              src={property.gallery[0] ?? property.image}
              alt={`${property.title} - Foto principal`}
              width="1200"
              height="800"
              loading="eager"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
            />
          </div>
          <!-- Secondary images -->
          <div class="lg:col-span-2 grid grid-cols-2 gap-3">
            {property.gallery.slice(1, 5).map((img, i) => (
              <div class="aspect-[4/3] overflow-hidden">
                <img
                  src={img}
                  alt={`${property.title} - Foto ${i + 2}`}
                  width="600"
                  height="400"
                  loading="lazy"
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                />
              </div>
            ))}
            {property.gallery.length < 5 && Array.from({ length: 4 - Math.max(0, property.gallery.length - 1) }).map((_, i) => (
              <div class="aspect-[4/3] bg-cream-dark rounded-lg flex items-center justify-center">
                <svg class="w-8 h-8 text-cream" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Property Detail -->
    <section class="py-10 bg-cream">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

          <!-- Left: Details -->
          <div class="lg:col-span-2">
            <!-- Header -->
            <div class="mb-8">
              <div class="flex flex-wrap items-center gap-3 mb-3">
                <span class="bg-navy text-cream text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wide">
                  {typeLabels[property.type] ?? property.type}
                </span>
                <span class={`text-xs font-semibold px-3 py-1.5 rounded-full ${
                  property.status === 'available' ? 'bg-emerald-100 text-emerald-700'
                  : property.status === 'reserved' ? 'bg-amber-100 text-amber-700'
                  : 'bg-red-100 text-red-700'
                }`}>
                  {property.status === 'available' ? 'Disponible' : property.status === 'reserved' ? 'Reservado' : 'Vendido'}
                </span>
                <span class="text-xs text-muted bg-cream-dark/80 px-3 py-1.5 rounded-full">Ref: {property.reference}</span>
              </div>

              <h1 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold text-dark mb-2">
                {property.title}
              </h1>

              <p class="flex items-center gap-2 text-muted mb-4">
                <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                </svg>
                {property.location}
              </p>

              <p class="text-4xl font-display font-bold text-navy">
                {formatPrice(property.price)}
              </p>
            </div>

            <!-- Specs -->
            <div class="grid grid-cols-3 gap-4 bg-white rounded-2xl p-5 mb-8 border border-cream-dark">
              {[
                { label: 'Dormitorios', value: property.bedrooms, icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12h18M3 7c0-1.1.9-2 2-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/>` },
                { label: 'Baños', value: property.bathrooms, icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 9V2h12v7M3 9h18v2a6 6 0 01-6 6H9a6 6 0 01-6-6V9z"/>` },
                { label: 'Superficie', value: `${property.sqm}m²`, icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>` },
              ].map(spec => (
                <div class="text-center">
                  <svg class="w-6 h-6 text-gold mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={spec.icon}></svg>
                  <p class="text-2xl font-display font-bold text-dark">{spec.value}</p>
                  <p class="text-xs text-muted uppercase tracking-wide">{spec.label}</p>
                </div>
              ))}
            </div>

            <!-- Description -->
            <div class="mb-8">
              <h2 class="font-display text-xl font-bold text-dark mb-4">Descripción Completa</h2>
              <div class="text-muted leading-relaxed space-y-4 whitespace-pre-line text-sm">
                {property.longDescription}
              </div>
            </div>

            <!-- Features -->
            <div class="mb-8">
              <h2 class="font-display text-xl font-bold text-dark mb-4">Características y Equipamiento</h2>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {property.features.map(feature => (
                  <li class="flex items-center gap-3 text-sm text-dark">
                    <div class="w-5 h-5 rounded-full bg-gold-pale flex items-center justify-center shrink-0">
                      <svg class="w-3 h-3 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                      </svg>
                    </div>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Map placeholder -->
            <div class="mb-8">
              <h2 class="font-display text-xl font-bold text-dark mb-4">Ubicación</h2>
              <div class="rounded-2xl overflow-hidden bg-cream-dark h-64 flex items-center justify-center border border-cream-dark">
                <div class="text-center text-muted">
                  <svg class="w-12 h-12 mx-auto mb-3 text-gold/50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <p class="font-semibold text-dark">{property.location}</p>
                  <p class="text-sm">Barcelona, España</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Contact Sticky -->
          <div class="lg:col-span-1">
            <div class="sticky top-28">
              <!-- Contact Card -->
              <div class="bg-white rounded-2xl shadow-lg border border-cream-dark p-6 mb-6">
                <h3 class="font-display text-lg font-bold text-dark mb-1">¿Te interesa esta propiedad?</h3>
                <p class="text-xs text-muted mb-5">Contacta con nuestro agente y organiza una visita sin compromiso.</p>

                <!-- Agent -->
                <div class="flex items-center gap-3 p-4 bg-cream rounded-xl mb-5">
                  <div class="w-12 h-12 rounded-full overflow-hidden flex-shrink-0">
                    <img
                      src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=100&h=100&q=80"
                      alt="Marcos Álvarez - Agente Solera Estates"
                      width="100"
                      height="100"
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-dark">Marcos Álvarez</p>
                    <p class="text-xs text-gold">Agente API · Fundador</p>
                    <p class="text-xs text-muted">+34 93 000 00 00</p>
                  </div>
                </div>

                <!-- Form -->
                <form class="space-y-3" aria-label="Formulario de contacto para esta propiedad">
                  <div>
                    <label for="contact-name" class="sr-only">Tu nombre</label>
                    <input id="contact-name" type="text" placeholder="Tu nombre" class="w-full bg-cream rounded-xl px-4 py-3 text-sm text-dark border border-cream-dark focus:outline-none focus:ring-2 focus:ring-gold/40" required />
                  </div>
                  <div>
                    <label for="contact-email" class="sr-only">Tu email</label>
                    <input id="contact-email" type="email" placeholder="Tu email" class="w-full bg-cream rounded-xl px-4 py-3 text-sm text-dark border border-cream-dark focus:outline-none focus:ring-2 focus:ring-gold/40" required />
                  </div>
                  <div>
                    <label for="contact-phone" class="sr-only">Tu teléfono</label>
                    <input id="contact-phone" type="tel" placeholder="Tu teléfono" class="w-full bg-cream rounded-xl px-4 py-3 text-sm text-dark border border-cream-dark focus:outline-none focus:ring-2 focus:ring-gold/40" />
                  </div>
                  <div>
                    <label for="contact-msg" class="sr-only">Mensaje</label>
                    <textarea id="contact-msg" rows="3" placeholder={`Me interesa la propiedad ${property.reference}...`} class="w-full bg-cream rounded-xl px-4 py-3 text-sm text-dark border border-cream-dark focus:outline-none focus:ring-2 focus:ring-gold/40 resize-none"></textarea>
                  </div>
                  <button type="submit" class="btn-gold w-full text-white font-semibold py-3 rounded-xl text-sm">
                    Solicitar Información
                  </button>
                  <a href="https://wa.me/34930000000" target="_blank" rel="noopener noreferrer"
                     class="flex items-center justify-center gap-2 w-full bg-emerald-500 hover:bg-emerald-600 text-white font-semibold py-3 rounded-xl text-sm transition-colors">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                    </svg>
                    WhatsApp
                  </a>
                </form>
              </div>

              <!-- Price per sqm -->
              <div class="bg-gold-pale border border-gold/20 rounded-2xl p-4 text-center">
                <p class="text-xs text-muted mb-1">Precio por metro cuadrado</p>
                <p class="text-2xl font-display font-bold text-navy">
                  {formatPrice(Math.round(property.price / property.sqm))}<span class="text-sm font-sans font-normal text-muted">/m²</span>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Properties -->
    {otherProperties.length > 0 && (
      <section class="py-16 bg-cream-dark" aria-labelledby="related-title">
        <div class="max-w-7xl mx-auto px-6 lg:px-10">
          <h2 id="related-title" class="font-display text-2xl lg:text-3xl font-bold text-dark mb-8 section-title-accent">
            También te puede interesar
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {otherProperties.map((p, i) => (
              <PropertyCard property={p} delay={i + 1} />
            ))}
          </div>
        </div>
      </section>
    )}

  </main>

  <Footer />
</Layout>
