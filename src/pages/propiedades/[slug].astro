---
import Layout from '../../layouts/Layout.astro';
import { getPropertyBySlug, formatPrice, properties, getPropertyImage } from '../../data/properties';

export async function getStaticPaths() {
  return properties.map((p) => ({
    params: { slug: p.slug },
    props: { property: p },
  }));
}

const { property } = Astro.props;
const similar = properties.filter(p => p.slug !== property.slug && (p.type === property.type || p.district === property.district)).slice(0, 3);
---

<Layout
  title={`${property.title} | Solera Estates`}
  description={`${property.title} en ${property.neighborhood}, Barcelona. ${property.size}m², ${property.bedrooms} habitaciones, ${property.bathrooms} baños. ${formatPrice(property.price)}.`}
  canonical={`https://soleraestates.com/propiedades/${property.slug}`}
  ogType="website"
  ogTitle={`${property.title} - ${formatPrice(property.price)} | Solera Estates`}
>
  <section class="pt-32 pb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-slate-500 mb-8">
        <a href="/" class="hover:text-solera-400 transition-colors">Inicio</a>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/propiedades" class="hover:text-solera-400 transition-colors">Propiedades</a>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-slate-400">{property.title}</span>
      </nav>
    </div>
  </section>

  <!-- Gallery -->
  <section class="pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-4 h-[400px] md:h-[500px]">
        <div class="rounded-2xl overflow-hidden h-full">
          <img src={getPropertyImage(property.slug)} alt={property.title} class="w-full h-full object-cover" />
        </div>
        <div class="grid grid-rows-2 gap-4">
          <div class="rounded-2xl overflow-hidden">
            <img src={getPropertyImage(property.slug, 2)} alt={`${property.title} - Vista 2`} class="w-full h-full object-cover" />
          </div>
          <div class="rounded-2xl overflow-hidden">
            <img src={getPropertyImage(property.slug, 1)} alt={`${property.title} - Vista 3`} class="w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-10">
        <!-- Main info -->
        <div class="lg:col-span-2 space-y-8">
          <div>
            <h1 class="text-3xl md:text-5xl font-heading font-bold text-white mb-3">{property.title}</h1>
            <div class="flex items-center gap-2 text-slate-400">
              <svg class="w-5 h-5 text-solera-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>{property.neighborhood}, {property.district} · Barcelona</span>
            </div>
          </div>

          <!-- Key features row -->
          <div class="flex flex-wrap gap-4 p-6 glass-card">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-solera-500/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-solera-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
              </div>
              <div><div class="text-white font-heading font-semibold text-xl">{property.size}</div><div class="text-slate-400 text-xs">m²</div></div>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-solera-500/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-solera-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              </div>
              <div><div class="text-white font-heading font-semibold text-xl">{property.bedrooms}</div><div class="text-slate-400 text-xs">dormitorios</div></div>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-solera-500/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-solera-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <div><div class="text-white font-heading font-semibold text-xl">{property.bathrooms}</div><div class="text-slate-400 text-xs">baños</div></div>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-solera-500/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-solera-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <div><div class="text-white font-heading font-semibold text-xl">{property.energyRating}</div><div class="text-slate-400 text-xs">Rating energético</div></div>
            </div>
          </div>

          <!-- Description -->
          <div>
            <h2 class="text-2xl font-heading font-semibold text-white mb-4">Descripción</h2>
            <p class="text-slate-300 leading-relaxed whitespace-pre-line">{property.description}</p>
          </div>

          <!-- Features -->
          {property.features.length > 0 && (
            <div>
              <h2 class="text-2xl font-heading font-semibold text-white mb-4">Características</h2>
              <div class="grid sm:grid-cols-2 gap-3">
                {property.features.map(f => (
                  <div class="flex items-center gap-2 text-slate-300 text-sm">
                    <svg class="w-4 h-4 text-solera-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg>
                    {f}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <div class="glass-card p-6 sticky top-28">
            <div class="text-3xl font-heading font-bold gradient-text mb-6">{formatPrice(property.price)}</div>
            <div class="space-y-3 text-sm text-slate-400 mb-6">
              {property.floor && <div class="flex justify-between"><span>Planta</span><span class="text-slate-300">{property.floor}</span></div>}
              <div class="flex justify-between"><span>Año construcción</span><span class="text-slate-300">{property.yearBuilt}</span></div>
              <div class="flex justify-between"><span>Estado</span><span class="text-green-400">En venta</span></div>
            </div>
            <a href="/contacto" class="btn-primary w-full justify-center text-base py-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              Solicitar información
            </a>
            <p class="text-xs text-slate-500 text-center mt-3">Te responderemos en menos de 24h</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Similar -->
  {similar.length > 0 && (
    <section class="pb-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="section-title text-white mb-10">Propiedades similares</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {similar.map((p, i) => (
            <a href={`/propiedades/${p.slug}`} class="group glass-card overflow-hidden transition-all duration-500 hover:-translate-y-2">
              <div class="h-40 bg-gradient-to-br from-solera-500/20 to-solera-700/40 flex items-center justify-center">
                <svg class="w-12 h-12 text-white/10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
              </div>
              <div class="p-4">
                <h3 class="text-white font-heading font-semibold text-sm mb-1 group-hover:text-solera-300 transition-colors">{p.title}</h3>
                <div class="text-solera-400 font-bold font-heading">{formatPrice(p.price)}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
